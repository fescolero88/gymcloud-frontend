{{#withProfile}}
<div class="gc-clientpage-sidebar-avatar">
  <img src="{{avatar_url}}" alt="">
</div>
<button type="button" class="btn btn-link gc-clientpage-sidebar-edit show-client-form">Edit</button>
<h2 class="gc-clientpage-sidebar-name">{{first_name}} {{last_name}}</h2>
<input class="gc-clientpage-sidebar-userlink" type="text" disabled="disabled" value="http://gymcloud.com/clients/id/{{id}}">
{{/withProfile}}
