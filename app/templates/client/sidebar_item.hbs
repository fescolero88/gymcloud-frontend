{{#if isFolder}}<div class="gc-sidebar-folder">{{else}}<div class="gc-sidebar-item">{{/if}}
    <a data-entity-id="{{key}}" href="#my/{{type}}/{{key}}" class="row {{#if isFolder}}toggle-menu toggle-it{{/if}}">
    <span class="col-xs-2">
      <span class="{{#if isFolder}}fa fa-folder-o {{else}}fa fa-arrows draggable-handle{{/if}}"></span>
    </span>
    <span class="col-xs-10 gc-sidebar-folder-name" data-key="{{key}}">
      {{title}}
    </span>
  </a>
  <div class="gc-sidebar-sub">
    {{#each items}}
      {{> sidebar_item type=../type }}
    {{/each}}
  </div>
</div>
