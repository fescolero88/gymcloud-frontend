<a href="#" class="gc-sidebar-logo">
  <img src="app/images/gymcloud-logo.png" alt="">
</a>

<div class="nano">
  <div class="nano-content gc-sidebar-content">
    <div class="gc-assign-catch" style="min-height: 50px;"></div>
    <div class="gc-sidebar-menu-list">

      <div class="gc-sidebar-cat">
        <a href="#dashboard" class="row toggle-menu">
          <span class="col-xs-2">
            <span class="gc-sidebar-cat-icon fix-bg-img-icon-dashboard"></span>
          </span>
          <span class="col-xs-10 gc-sidebar-cat-name">
            Dashboard
          </span>
        </a>
      </div>
      <div class="gc-sidebar-cat" data-category="exercises">
        <a href="/#my/exercises/" class="row toggle-menu">
          <span class="col-xs-2">
            <span class="gc-sidebar-cat-icon fix-bg-img-icon-exercises"></span>
          </span>
          <span class="col-xs-8 gc-sidebar-cat-name">
            Exercises
          </span>
          <span class="col-xs-2 toggle-it">
            <span class="fa fa-chevron-down toggle-it"></span>
          </span>
        </a>
        <div class="gc-sidebar-sub">
          {{#each exercises}}
            {{> sidebar_item type="exercises"}}
          {{/each}}
        </div>
      </div>
      <div class="gc-sidebar-cat" data-category="workouts">
        <a href="/#my/workouts/" class="row toggle-menu">
          <span class="col-xs-2">
            <span class="gc-sidebar-cat-icon fix-bg-img-icon-workouts"></span>
          </span>
          <span class="col-xs-8 gc-sidebar-cat-name">
            Workouts
          </span>
          <span class="col-xs-2 toggle-it">
            <span class="fa fa-chevron-down toggle-it"></span>
          </span>
        </a>
        <div class="gc-sidebar-sub">
          {{#each workouts}}
            {{> sidebar_item type="workouts"}}
          {{/each}}
        </div>
      </div>
      <div class="gc-sidebar-cat" data-category="programs">
        <a href="/#my/programs/" class="row toggle-menu">
          <span class="col-xs-2">
            <span class="gc-sidebar-cat-icon fix-bg-img-icon-programs"></span>
          </span>
          <span class="col-xs-8 gc-sidebar-cat-name">
            Programs
          </span>
          <span class="col-xs-2 toggle-it">
            <span class="fa fa-chevron-down toggle-it"></span>
          </span>
        </a>
        <div class="gc-sidebar-sub">
          {{#each programs}}
            {{> sidebar_item type="programs"}}
          {{/each}}
        </div>
      </div>

    </div>
  </div>
</div>

