<div class="modal fade gc-modal" id="gc-edit-profile-modal">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span>Close</span></button>
        <h4 class="modal-title">
          <span><img src="../static/images/icon-individuals.png" alt=""></span>
          Edit John Doe information
        </h4>
      </div>
      <form class="form" role="form">
        <div class="modal-body">
          <div class="row">
            <div class="col-xs-3">
               <div class="gc-edit-profile-modal-upload-wrapper">
                <input type="file" class="gc-edit-profile-modal-upload-input">
                <p href="#" class="gc-edit-profile-modal-upload-text">
                  <span class="fa fa-plus"></span>
                  Upload
                  <br>
                  photo
                </p>
                <img src="../static/images/portrait-2.jpg" alt=" " class="gc-edit-profile-modal-avatar">
              </div>
            </div>
            <div class="col-xs-9">
              <div class="form-group">
                <div class="row">
                  <div class="col-xs-2">
                    <label for="r1">Gender</label>
                  </div>
                  <div class="col-xs-2">
                    <label>
                      <input type="radio" name="r1"> <span>Male</span>
                    </label>
                  </div>
                  <div class="col-xs-2">
                    <label>
                      <input type="radio" name="r1"> <span>Female</span>
                    </label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-xs-4">
                  <div class="form-group">
                    <label for="">Weight <span class="gc-req">*</span></label>
                    <input type="text" class="form-control">
                  </div>
                </div>
                <div class="col-xs-4">
                  <div class="form-group">
                    <label for="">Height <span class="gc-req">*</span></label>
                    <input type="text" class="form-control">
                  </div>
                </div>
                <div class="col-xs-4">
                  <div class="form-group">
                    <label for="">Bodyfat <span class="gc-req">*</span></label>
                    <input type="text" class="form-control">
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-xs-12">
                  <div class="form-group">
                    <label for="">First name</label>
                    <input type="text" class="form-control">
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-xs-12">
                  <div class="form-group">
                    <label for="">Last name</label>
                    <input type="text" class="form-control">
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-xs-12">
                  <div class="form-group gc-valid">
                    <label for="">Email</label>
                    <input type="text" class="form-control">
                    <span class="gc-valid-icon fa fa-check"></span>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-xs-8">
                  <div class="form-group gc-invalid">
                    <label for="">Location <span class="gc-req">*</span></label>
                    <label for="" class="gc-error-message">Empty field</label>
                    <input type="text" class="form-control">
                    <span class="gc-valid-icon fa fa-check"></span>
                  </div>
                </div>
                <div class="col-xs-4">
                  <div class="form-group">
                    <label for="">ZIP</label>
                    <label for="" class="gc-error-message">Empty field</label>
                    <input type="text" class="form-control">
                    <span class="gc-valid-icon fa fa-check"></span>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-xs-12">
                  <div class="form-group">
                    <label for="">Employer</label>
                    <input type="text" class="form-control">
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-xs-4">
                  <div class="form-group">
                    <label for="">Date of birth</label>
                    <input type="date" class="form-control">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <div class="row">
            <div class="col-xs-12 text-right"><button type="submit" class="btn btn-primary">Save</button></div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
