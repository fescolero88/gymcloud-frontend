<div class="gc-clientpage-nav-trainer-wrapper row">
  <div class="col-xs-6">
    <h2 class="gc-clientpage-nav-title"></h2>
  </div>
  <div class="col-xs-6 gc-client-trainer-actions">
    <div class="gc-clientpage-nav-trainer-avatar-block">
      <div class="gc-clientpage-nav-trainer-avatar-wrapper">
        {{#withProfile}}
        <img src="{{avatar_url}}" alt="">
        {{/withProfile}}
      </div>
    </div>
    <div class="gc-clientpage-nav-trainer-action-wrapper">
      <p>
        <span>
          Trainer:
        </span>
        <span class="gc-clientpage-trainer-name">
          {{first_name}} {{last_name}}
        </span>
      </p>
    </div>
    <div class="gc-clientpage-nav-trainer-message-wrapper">
      <button class="btn btn-inverse gc-custom btn-sm">Message trainer</button>
    </div>
  </div>
</div>
