<div class="row">
  <div class="col-xs-3 draggable-handle">
    <i class="fa fa-arrows-v"></i>
    <span data-weight="{{weight}}">{{name}}</span>
  </div>
  <div class="col-xs-3">
    {{default}}
  </div>
  <div class="col-xs-4">
    {{type}}
  </div>
  <div class="col-xs-2 gc-properties-property-actions">
    <button type="button" class="btn btn-primary gc-properties-property-edit" data-toggle="modal" data-target="#gc-edit-property-modal">
      Edit
    </button>
    <button type="button" class="btn btn-link gc-properties-property-delete">
      <i class="fa fa-trash"></i>
    </button>
  </div>
</div>
