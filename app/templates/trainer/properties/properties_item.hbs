<div class="row">
  <div class="col-xs-3 draggable-handle">
    <i class="fa fa-arrows-v"></i>
    <span data-weight="{{weight}}">{{name}}</span>
  </div>
  <div class="col-xs-3">
    {{defaultvalue}}
  </div>
  <div class="col-xs-4">
    {{value_type}}
  </div>
  <div class="col-xs-2 gc-properties-property-actions">
    <a href="#" data-id="{{id}}" class="btn btn-primary gc-properties-property-edit">
      Edit
    </a>
    <a href="#" data-id="{{id}}" class="btn btn-link gc-properties-property-delete">
      <i class="fa fa-trash"></i>
    </a>
  </div>
</div>
