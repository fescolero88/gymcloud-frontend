.col-xs-3.draggable-handle
  i.fa.fa-arrows-v
  span(data-weight="#{global_property.symbol}")= global_property.name
.col-xs-3= defaultvalue
.col-xs-4= global_property.unit
.col-xs-2.gc-properties-property-actions
  a.btn.btn-primary.gc-properties-property-edit(href='#', data-id="#{id}")
    | Edit
  a.btn.btn-link.gc-properties-property-delete(href='#', data-id="#{id}")
    i.fa.fa-trash