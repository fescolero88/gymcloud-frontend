<div class="gc-main-workspace row">
  <div class="col-xs-12 gc-content-both">
    <nav class="gc-clients-nav-wrapper row">
      <div class="col-xs-6 gc-clients-nav-left">
        <h2>Properties</h2>
        <button data-toggle="modal" data-target="#gc-add-property-modal" class="btn btn-link">
          <span class="fa fa-plus"></span>
          Add property
        </button>
      </div>
    </nav>
    <div class="gc-properties-list-wrapper row">
      <div class="col-xs-12">
        {{#if collection}}
        <div class="row gc-properties-list-header">
          <div class="col-xs-3">Property Name</div>
          <div class="col-xs-3">Default Value</div>
          <div class="col-xs-4">Value Type</div>
          <div class="col-xs-2">Actions</div>
        </div>
        <ul class="gc-properties-list">
        </ul>
        {{else}}
        <div class="gc-properties-list-empty">
          <img src="../static/images/icon-properties-empty.png" alt="">
          <p>
            You don't have
            <br>
            any properties set.
          </p>
          <button data-toggle="modal" data-target="#gc-add-property-modal" class="btn btn-link">Add new property</button>
        </div>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<div class="modal fade gc-modal" id="gc-add-property-modal">
  <div class="modal-dialog modal-md">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span>Close</span></button>
        <h4 class="modal-title">
          <span>
            <img src="../static/images/icon-properties.png" alt="">
          </span>
          Add Property
        </h4>
      </div>
      <form class="form" role="form">
        <div class="modal-body">
          <div class="form-group">
            <label class="control-label">Property Name</label>
            <input type="text" class="form-control" placeholder="">
          </div>
          <div class="form-group">
            <label class="control-label">Default Value</label>
            <input type="text" class="form-control" placeholder="">
          </div>
          <div class="form-group">
            <label class="control-label">Value Type</label>
            <select type="text" class="form-control">
              <option value="1">Numeric</option>
              <option value="2">String</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <div class="row">
            <div class="col-xs-12 text-right"><button type="submit" class="btn btn-primary">Save</button></div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade gc-modal" id="gc-edit-property-modal">
  <div class="modal-dialog modal-md">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span>Close</span></button>
        <h4 class="modal-title">
          <span>
            <img src="../static/images/icon-properties.png" alt="">
          </span>
          Edit
        </h4>
      </div>
      <form class="form" role="form">
        <div class="modal-body">
          <div class="form-group">
            <label class="control-label">Property Name</label>
            <input type="text" class="form-control" placeholder="">
          </div>
          <div class="form-group">
            <label class="control-label">Default Value</label>
            <input type="text" class="form-control" placeholder="">
          </div>
          <div class="form-group">
            <label class="control-label">Value Type</label>
            <select type="text" class="form-control">
              <option value="1">Numeric</option>
              <option value="2">String</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <div class="row">
            <div class="col-xs-12 text-right"><button type="submit" class="btn btn-primary">Save</button></div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
