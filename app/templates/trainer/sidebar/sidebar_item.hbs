{{#if isFolder}}<div class="gc-sidebar-folder">{{else}}<div class="gc-sidebar-item">{{/if}}
  <a href="#" class="row {{#if isFolder}}toggle-menu{{/if}}">
    <span class="col-xs-2">
      <span class="{{#if isFolder}}fa fa-folder-o {{else}}glyphicon glyphicon-th draggable-handle{{/if}}"></span>
    </span>
    <span class="col-xs-10 gc-sidebar-folder-name" data-key="{{key}}">
      {{title}}
    </span>
  </a>
  <div class="gc-sidebar-sub">
    {{#each items}}
      {{> sidebar_item}}
    {{/each}}
  </div>
</div>
