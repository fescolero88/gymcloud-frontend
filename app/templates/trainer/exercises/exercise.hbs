<div class="gc-exercises-exercise-view">
  <h2>{{name}}</h2>
  {{#if description}}
  <p class="gc-exercises-exercise-descr">
    {{description}}
  </p>
  {{/if}}
  {{#if video_url}}
  <div class="gc-exercises-exercise-video">
    <iframe width="853" height="480" src="{{video_url}}" frameborder="0" allowfullscreen></iframe>
  </div>
  {{/if}}
</div>
