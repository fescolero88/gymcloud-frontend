<div class="gc-main-workspace row">
  <div class="col-xs-12 gc-content-both">
    <div class="gc-clients-nav-wrapper row">
      <div class="col-xs-7 gc-clients-nav-left">
        <label class="gc-content-nav-checkall">
          <input type="checkbox">
        </label>
        <a class="gc-content-nav-back">
          <span class="fa fa-chevron-left"></span>
        </a>
        <div id="breadcrumbs"></div>
      </div>
      <div class="col-xs-5 gc-clients-nav-right text-right">
        {{#withProfile}}
          {{#ifEqual id ../author}}
            <ul class="gc-content-nav">
              <li class="active"><a>Exercise</a></li>
              <li><a>Add video</a></li>
              <li><a>Assign</a></li>
            </ul>
          {{else}}
            <button class="btn brn-primary">Add to library</button>
          {{/ifEqual}}
        {{/withProfile}}
      </div>
    </div>
    <div id="exercise-manage"></div>
  </div>
</div>
