<div class="gc-main-workspace row">
  <div class="col-xs-12 gc-content-both">
    <div class="gc-clients-nav-wrapper row">
      <div class="col-xs-7 gc-clients-nav-left">
        <label class="gc-content-nav-checkall">
          <input type="checkbox">
        </label>
        <a class="gc-content-nav-back">
          <span class="fa fa-chevron-left"></span>
        </a>
        <div id="breadcrumbs"></div>
      </div>
      <div class="col-xs-5 gc-clients-nav-right text-right">
        <button class="btn brn-primary">Add to library</button>
      </div>
    </div>
    <div class="gc-exercises-exercise-view">
      <div class="row gc-exercise-info">
        <div class="col-xs-6">
          <h2>{{name}}</h2>
        </div>
        <div class="col-xs-6 text-right">
          <div class="gc-exercise-author-info">
            <a href="" class="gc-exercise-author-avatar gc-exercise-author-avatar-exist">
              <img src="static/images/portrait.jpg">
            </a>
            <p class="gc-exercise-author-name">
              Trainer
              <br>
              <a>Helen Schmidt</a>
            </p>
          </div>
          <div class="gc-exercise-rating">
            <div>
              <span class="gc-exercise-rating-count">25</span>
              <ul class="gc-exercise-rating-stars">
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star-o"></i></li>
              </ul>
            </div>
            <p class="gc-exercise-rating-used">
              Used by <i class="glyphicon glyphicon-user"></i> 250
            </p>
          </div>
        </div>
      </div>
      {{#if description}}
      <p class="gc-exercises-exercise-descr">
        {{description}}
      </p>
      {{/if}}
      {{#if video_url}}
      <div class="gc-exercises-exercise-video">
        <iframe width="853" height="480" src="{{video_url}}" frameborder="0" allowfullscreen></iframe>
      </div>
      <a href="{{video_url}}" target="_blank" class="gc-exercises-exercise-video-link">
        {{name}}
        <i class="fa fa-youtube-play"></i>
        <span>Youtube</span>
      </a>
      {{/if}}
    </div>
  </div>
</div>
