<div class="gc-main-workspace row">
  <div class="col-xs-12 gc-content-both">
    <div class="gc-nav-wrapper row">
      <div class="col-xs-7 gc-clients-nav-left">
        <a class="gc-content-nav-back">
          <span class="fa fa-chevron-left"></span>
        </a>
        <div id="breadcrumbs"></div>
      </div>
      <div class="col-xs-5 gc-exercises-nav-right text-right">
        {{#ifEqual userId authorId}}
          <ul class="gc-content-nav">
            <li data-view="overview" class="active"><a>Exercise</a></li>
            <li data-view="video"><a>Add video</a></li>
            <li data-view="assign"><a>Assign</a></li>
          </ul>
        {{else}}
          {{#ifNot public false}}<button class="btn brn-primary gc-add-to-library-button">Add to library</button>{{/ifNot}}
        {{/ifEqual}}
        <span class="{{#ifNot public true}}hide{{/ifNot}} btn btn-success gc-privacy-marker gc-privacy-public">
          <i class="fa fa-eye"></i>
          Public
        </span>
        <span class="{{#if public}}hide{{/if}} btn btn-warning gc-privacy-marker gc-privacy-private">
          <i class="fa fa-lock"></i>
          Private
        </span>
      </div>
    </div>
    <div id="exercise-manage"></div>
  </div>
</div>
