<div class="gc-exercises-exercise-view">
  <form role="form" class="gc-exercise-edit-form">
    <div class="row">
      <div class="col-xs-12">
        <div class="form-group">
          <label class="control-label" for="title">Title</label>
          <label class="gc-error-message"></label>
          <input id="title" class="form-control" name="name" type="text" value="{{name}}">
          <span class="gc-valid-icon fa fa-check hide"></span>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-xs-12">
        <div class="form-group">
          <label class="control-label" for="description">Description</label>
          <label class="gc-error-message"></label>
          <textarea id="description" class="form-control" name="description" rows="4">{{description}}</textarea>
          <span class="gc-valid-icon fa fa-check hide"></span>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-xs-12">
        <div class="form-group">
          <div class="gc-exercises-exercise-video-placeholder text-center">
            <div class="gc-exercises-exercise-video-placeholder-icon">
              <i class="glyphicon glyphicon-play"></i>
            </div>
            <p>
              Seems you don't have any videos.
              <br>
              You can either upload one or select from a list.
            </p>
            <button class="btn btn-primary">Add video to this exercise</button>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-xs-6">
        <button class="btn btn-link gc-exercise-back-button">Back</button>
      </div>
      <div class="col-xs-6 text-right">
        <button class="btn btn-primary gc-exercise-save-button" type="submit">Save</button>
      </div>
    </div>
  </form>
</div>
