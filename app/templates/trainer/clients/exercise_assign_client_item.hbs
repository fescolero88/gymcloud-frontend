<div class="col-xs-11">
  {{#ifEqual type "Individuals"}}
    <a class="gc-clients-list-avatar-wrapper {{#if avatar_url}}gc-clients-list-avatar-exist{{/if}}" style="background-color: {{avatar_background_color}}">
      <img src="{{avatar_url}}" alt="">
    </a>
    <a class="gc-clients-list-client-link">
      {{first_name}} {{last_name}}
    </a>
  {{else}}
    <a class="gc-clients-list-avatar-wrapper gc-clients-list-avatar-group {{#if avatar_url}}gc-clients-list-avatar-exist{{/if}}" style="background-color: {{avatar_background_color}}">
      <img src="{{avatar_url}}" alt="">
    </a>
    <a class="gc-clients-list-client-link">
      {{name}}
    </a>
  {{/ifEqual}}
</div>
<div class="col-xs-1 text-right gc-global-ewp-assigned-mark">
  <i data-id="{{id}}" class="glyphicon glyphicon-ok"></i>
</div>
