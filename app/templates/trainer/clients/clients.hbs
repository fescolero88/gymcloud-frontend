<div class="gc-main-workspace row">
  <div class="col-xs-12 gc-content-both">
    <div class="gc-clients-nav-wrapper row">
      <div class="col-xs-6 gc-clients-nav-left">
        <label class="gc-content-nav-checkall">
          <input type="checkbox">
        </label>
        <h2>Clients</h2>
        {{#ifNot view_type 'groups'}}
        <a href="#" class="btn btn-link show-client-form">
          <span class="fa fa-plus"></span>
          Add client
        </a>
        {{/ifNot}}
        {{#ifNot view_type 'individuals'}}
        <a href="#" class="btn btn-link show-group-form">
          <span class="fa fa-plus"></span>
          Add group
        </a>
        {{/ifNot}}
      </div>
      <div class="col-xs-6 gc-clients-nav-right text-right">
        <p class="hidden"><span></span> client(s) selected</p>
        <a href="#" style="display:none;" class="btn btn-link move-to-group-show">Move to group</a>
        <a href="#" style="display:none;" id="rm-event" class="btn btn-danger">
          <span class="fa fa-trash"></span>
        </a>
      </div>
    </div>
    <div class="gc-clients-list-wrapper row">
      <div class="col-xs-12" id="clients-region"></div>
      <div class="col-xs-12" id="groups-region"></div>
    </div>
  </div>
</div>

<div class="modal fade gc-modal" id="gc-move-to-group-modal"></div>
<div class="modal fade gc-modal" id="gc-add-group-modal"></div>
<div class="modal fade gc-modal" id="gc-add-client-modal"></div>
