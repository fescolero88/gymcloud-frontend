<div class="gc-usercard-large row">
  <div class="col-xs-10">
    <div class="gc-usercard-avatar-wrapper text-center">
      <img class="gc-usercard-avatar" src="{{avatar_url}}" alt="">
    </div>
    <div class="gc-usercard-info">
      {{#if view_type}}
      <h1 class="gc-usercard-name">{{first_name}} {{last_name}}</h1>
      {{else}}
      <h1 class="gc-usercard-name">{{name}}</h1>
      {{/if}}
      <p class="gc-usercard-address">{{location}} {{zip}}</p>
      <input type="text" value="http://gymcloud.com/clients/john-doe" class="gc-usercard-link" readonly="readonly">
      <div class="btn-group gc-usercard-actions" role="group">
        {{#if view_type}}
        <button type="button" class="btn btn-default" data-toggle="modal" data-target="#gc-new-message-modal">New message</button>
        <button type="button" class="btn btn-default" data-toggle="modal" data-target="#gc-invite-client-modal">Invite client</button>
        {{/if}}
        <button type="button" class="btn btn-default show-client-form">Edit profile</button>
      </div>
    </div>
  </div>
  <div class="col-xs-2 gc-usercard-params text-right">
    {{#if view_type}}
    <dl>
      <dt>Height</dt>
      <dd>{{height}}</dd>
      <dt>Weight</dt>
      <dd>{{weight}}</dd>
      <dt>Bodyfat</dt>
      <dd>{{bodyfat}}</dd>
      <dt>Age</dt>
      <dd>{{getAge dob}}</dd>
      <dt>Sex</dt>
      <dd>{{getSex gender}}</dd>
    </dl>
    {{/if}}
  </div>
</div>

<div class="modal fade gc-modal" id="gc-invite-client-modal">
  <div class="modal-dialog modal-md">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span>Close</span></button>
        <h4 class="modal-title">
          <span><img src="../static/images/icon-individuals.png" alt=""></span>
          Invite client
        </h4>
      </div>
      <form class="form invite-client-form" role="form">
        <div class="modal-body">
          <div class="row">
            <div class="col-xs-12">
              <div class="row">
                <div class="col-xs-12">
                  <div class="form-group">
                    <label for="">Client's email</label>
                    <input type="text" class="form-control" name="email" placeholder="Email">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <div class="row">
            <div class="col-xs-12 text-right"><button type="submit" class="btn btn-primary">Invite</button></div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade gc-modal" id="gc-new-message-modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span>Close</span></button>
        <h4 class="modal-title">
          <span><img src="../static/images/icon-individuals.png" alt=""></span>
          Send message
        </h4>
      </div>
      <form class="form" role="form">
        <div class="modal-body">
          <div class="row">
            <div class="col-xs-12">
              <div class="row">
                <div class="col-xs-12">
                  <div class="form-group">
                    <label for="">Send to:</label>
                    <input type="text" class="form-control">
                  </div>
                  <div class="gc-message-modal-actions row">
                    <div class="col-xs-3">
                        <a href="#" class="btn btn-link"><span class="fa fa-check"></span> Select all</a>
                    </div>
                    <div class="col-xs-5">
                      <a href="#" class="btn btn-link"><span class="fa fa-remove"></span> Select none</a>
                    </div>
                    <div class="col-xs-4 text-right">
                      <a href="#" class="btn btn-link"><span class="fa fa-repeat"></span> Reset</a>
                    </div>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-xs-12">
                  <div class="form-group">
                    <label for="">Message:</label>
                    <textarea class="form-control"></textarea>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <div class="row">
            <div class="col-xs-12 text-right"><button type="submit" class="btn btn-primary">Send</button></div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade gc-modal" id="gc-edit-client-modal"></div>
