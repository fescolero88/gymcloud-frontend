<div class="modal-content">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal"><span>Close</span></button>
    <h4 class="modal-title">
      <span class="gc-modal-icon-lg"><img src="../static/images/icon-groups.png" alt=""></span>
      {{#if id}}
      Edit group {{name}}
      {{else}}
      Add group
      {{/if}}
    </h4>
  </div>
  <form class="form group-form" role="form">
    <div class="modal-body">
      <div class="row">
        <div class="col-xs-3">
          <div class="gc-edit-profile-modal-upload-wrapper">
            <input type="file" class="gc-edit-profile-modal-upload-input">
            <p class="gc-edit-profile-modal-upload-text">
              <span class="fa fa-plus"></span>
              Upload
              <br>
              photo
            </p>
            <img class="gc-edit-profile-modal-avatar" src=""/>
          </div>
        </div>
        <div class="col-xs-9">
          <div class="row">
            <div class="col-xs-12">
              <div class="form-group">
                <label for="name">Group name <span class="gc-req">*</span></label>
                <label class="gc-error-message"></label>
                <input type="text" name="name" class="form-control" value="{{name}}">
                <span class="gc-valid-icon fa fa-check hide"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <div class="row">
        <div class="col-xs-12 text-right"><button type="submit" class="btn btn-primary">Save</button></div>
      </div>
    </div>
  </form>
</div>
