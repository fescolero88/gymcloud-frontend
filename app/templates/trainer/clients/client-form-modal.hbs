<div class="modal-content">
  <div class="modal-header">
    <button class="close" data-dismiss="modal"><span>Close</span></button>
    <h4 class="modal-title">
      <span class="gc-modal-icon-sm"><img src="app/images/add-client-icon.svg" alt=""></span>
      {{#if id}}
      Edit {{first_name}} {{last_name}} information
      {{else}}
      Add client
      {{/if}}
    </h4>
  </div>
  <form class="form" role="form">
    <div class="modal-body">
      <div class="row">
        <div class="col-xs-12">
          <div class="form-group">
          </div>
          <div class="row">
            <div class="col-xs-12">
              <div class="form-group">
                <label for="first_name">Name</label>
                <label class="gc-error-message"></label>
                <input name="first_name" type="text" class="form-control" value="{{first_name}}" placeholder="Name">
                <span class="gc-valid-icon fa fa-check hide"></span>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-xs-12">
              <div class="form-group">
                <label for="email">Email</label>
                <label class="gc-error-message"></label>
                <input name="email" type="text" class="form-control" value="{{email}}" placeholder="Email">
                <span class="gc-valid-icon fa fa-check hide"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <div class="row">
        <div class="col-xs-12 text-right">
          <button type="submit" class="btn btn-primary">Save</button>
          <span class="button-separate">or</span>
          <button class="btn btn-primary">SAVE & Invite TO GYMCLOUD</button>
        </div>
      </div>
    </div>
  </form>
</div>
