<header>
  <h3>
    Recent activity
  </h3>
</header>
{{#if items}}
<ul class="gc-calendar-activity">
  {{#each items}}
  <li class="row">
    <div class="col-xs-2 text-right">
      <span class="fa fa-clock-o"></span>
    </div>
    <div class="col-xs-10">
      <h6>{{prettifyDate created_at}}</h6>
      <p>{{{activityMessage this}}}</p>
    </div>
  </li>
  {{/each}}
</ul>
{{#unless noMore}}
<div class="text-center">
  <a href="#" class="load-more">Load More</a>
</div>
{{/unless}}
{{else}}
<div class="gc-content-right-exercises-empty">
  <img src="app/images/icon-plane-large.png" alt=" ">
  <p>
    Soon you will see
    <br>
    activity updates here
  </p>
</div>
{{/if}}
