{{#withProfile}}
<div class="row">
  <div class="col-xs-12">
    <div class="form-group">

      {{#ifEqual id ../workout.author.id}}
      <textarea class="gc-workout-description-editor form-control" type="text" placeholder="Start typing a description here...">{{../../description}}</textarea>
      {{else}}
      <div class="gc-workout-description" type="text" placeholder="Start typing a description here...">{{../../description}}</div>
      {{/ifEqual}}
    </div>
  </div>
</div>
<div id="gc-exercises-list-region"></div>
{{#ifEqual id ../workout.author.id}}
<div class="row">
  <div class="col-xs-6">
  </div>


  <div class="col-xs-6 text-right">

    <!-- privacy controls -->
    <div class="btn-group" data-toggle="buttons">
      <label class="btn btn-primary {{#if ../../is_public}}active{{/if}}">
        <input type="radio" name="privacy" {{#if ../../is_public}}checked{{/if}} value="true" /> Public
      </label>
      <label class="btn btn-primary {{#unless ../../is_public}}active{{/unless}}">
        <input type="radio" name="privacy" value="false" {{#unless ../../is_public}}checked{{/unless}} /> Private
      </label>
    </div>
    <!-- / privacy controls -->

    <button class="btn btn-primary gc-workout-delete-button">Delete workout</button>
  </div>

</div>
{{/ifEqual}}
<div class="row">
  <div class="col-xs-12">
    <div class="form-group">
    </div>
  </div>
</div>
{{/withProfile}}
