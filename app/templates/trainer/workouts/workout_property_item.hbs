<div class="btn-group clearfix gc-property editable">
  <button type="button" class="btn btn-sm btn-primary gc-custom">
    <i class="gc-icon-bars"></i>
    &nbsp;<span contenteditable="true" class="gc-property-value">{{defaultPropertyValue}}</span>
  </button>
  <div class="btn-group" role="group">
    <button type="button" class="btn btn-sm btn-primary gc-custom dropdown-toggle" data-toggle="dropdown">
      <span class="gc-selected-property">{{defaultProperty}}</span>&nbsp;
      <i class="fa fa-sort"></i>
    </button>
    <ul class="dropdown-menu gc-dropdown">
      {{#each properties}}
      <li><a href="#" class="gc-property-item" data-id="{{id}}"  data-default-value="{{defaultvalue}}">{{name}}</a></li>
      {{/each}}
    </ul>
  </div>
  <button type="button" class="btn btn-sm btn-primary gc-custom gc-remove">
    &times;
  </button>
</div>
