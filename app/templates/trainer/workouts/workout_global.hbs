{{#withProfile}}
  <div class="gc-main-workspace row">
    <div class="col-xs-12 gc-content-both">
      <div class="gc-clients-nav-wrapper row">
        <div class="col-xs-7 gc-clients-nav-left">
          <a class="gc-content-nav-back">
            <span class="fa fa-chevron-left"></span>
          </a>
          <div class="gc-workout-title">
            <h2>
              <span contenteditable="true">{{../workout.name}}</span>
            </h2>
          </div>
        </div>
        <div class="col-xs-5 gc-exercises-nav-right text-right">
          {{#ifEqual id ../workout.author.id}}
            <a class="gc-workout-actions-button btn btn-primary" data-toggle="dropdown" id="gc-workout-actions-dropdown" aria-haspopup="true" role="button" aria-expanded="false">
              <i class="fa fa-chevron-down"></i>
            </a>
            <ul class="dropdown-menu pull-right gc-workout-actions-list" role="menu" aria-labelledby="gc-workout-actions-dropdown">
              <li class="row">
                <a class="col-xs-12">
                  Add Note
                </a>
              </li>
              <li class="row">
                <a class="col-xs-12">
                  Edit Description
                </a>
              </li>
              <li class="row">
                <a class="col-xs-12">
                  Add Video
                </a>
              </li>
              <li class="row">
                <a class="col-xs-12 text-danger">
                  Delete
                </a>
              </li>
            </ul>

          {{else}}
            <button class="btn brn-primary">Add to library</button>
          {{/ifEqual}}
        </div>
      </div>
      <div class="row gc-inner-nav-wrapper">
        <div class="col-xs-6">
          <ul class="gc-inner-nav">
              <li class="active" data-view="description"><a>Description</a></li>
              <li data-view="video"><a>Video</a></li>
          </ul>
        </div>
        <div class="col-xs-6">
          {{#ifNot id ../workout.author.id}}
          <div class="gc-workout-author-block pull-right">
            <div class="gc-exercise-author-info">
              <a  href="#/tr/clients/id/{{this.id}}/exercises/" class="gc-exercise-author-avatar gc-exercise-author-avatar-exist">
                <img src="{{this.avatar_url}}"  onerror="this.src='app/images/avatar-placeholder.png';">
              </a>
              <p class="gc-exercise-author-name">
                Trainer
                <br>
                <a href="#/tr/clients/id/{{this.id}}/exercises/">{{this.first_name}} {{this.last_name}}</a>
              </p>
            </div>
            <div class="gc-rating">
              <div>
                <span class="gc-rating-count">25</span>
                <ul class="gc-rating-stars">
                  <li><i class="fa fa-star"></i></li>
                  <li><i class="fa fa-star"></i></li>
                  <li><i class="fa fa-star"></i></li>
                  <li><i class="fa fa-star"></i></li>
                  <li><i class="fa fa-star-o"></i></li>
                </ul>
              </div>
              <p class="gc-rating-used pull-right text-right">
                Used by <i class="glyphicon glyphicon-user"></i> 250
              </p>
            </div>
          </div>
          {{/ifNot}}
        </div>
      </div>
      <div id="workout-manage"></div>
    </div>
  </div>
{{/withProfile}}
