<div class="gc-main-workspace row">
  <div class="col-xs-12 gc-content-both">
    <div class="gc-clients-nav-wrapper row">
      <div class="col-xs-7 gc-clients-nav-left">
        <a class="gc-content-nav-back">
          <span class="fa fa-chevron-left"></span>
        </a>
        <div id="breadcrumbs"></div>
      </div>
      <div class="col-xs-5 gc-exercises-nav-right text-right">
        {{#withProfile}}
          {{#ifEqual id ../author}}
            <a class="gc-topbar-avatar-exist" data-toggle="dropdown" id="gc-workout-actions-dropdown" aria-haspopup="true" role="button" aria-expanded="false">
              <i class="fa fa-chevron-down"></i>
            </a>
            <ul class="dropdown-menu pull-right" role="menu" aria-labelledby="gc-workout-actions-dropdown">
              <li class="row">
                <a class="col-xs-12">
                  Add Note
                </a>
              </li>
              <li class="row">
                <a class="col-xs-12">
                  Edit Description
                </a>
              </li>
              <li class="row">
                <a class="col-xs-12">
                  Add Video
                </a>
              </li>
              <li class="row">
                <a class="col-xs-12 text-danger">
                  Delete
                </a>
              </li>
            </ul>
          {{else}}
            Nope
          {{/ifEqual}}
        {{/withProfile}}
      </div>
    </div>
    <div id="exercise-manage"></div>
  </div>
</div>
