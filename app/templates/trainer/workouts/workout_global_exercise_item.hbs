<span class="pull-left gc-workout-exercise-sort" data-id="{{exercise_id}}" data-position="{{position}}" data-workout-id="{{id}}"></span>
<div class="gc-workout-exercise-circle" data-letter="{{letterByNumber order_name}}" style="background: {{colorByLetterNumber order_name}}">
  {{letterByNumber order_name}}{{position}}
</div>
<a href="#tr/global/exercises/id/{{id}}"class="gc-workout-exercise-name">{{name}}</a>
{{#each properties}}
<div class="gc-workout-exercise-prop"><i class="fa fa-align-left"></i>{{value}} {{name}}</div>
{{/each}}