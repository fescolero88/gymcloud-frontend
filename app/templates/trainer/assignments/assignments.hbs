<div class="gc-exercises-assign">
  <div class="gc-exercises-assign-input-wrapper">
    <input type="text" class="gc-exercises-assign-input form-control live-search" placeholder="Assign Exercises, Workouts, and Programs">
  </div>
  {{#if items}}
  <ul class="gc-exercises-assign-list">
    {{#each items}}
    <li class="row">
      <div class="col-xs-8">
        <label class="gc-exercises-chb">
          <input type="checkbox">
        </label>
        <a class="gc-exercises-link" href="/#clients/id/{{../client_id}}/{{../assign_name}}/{{id}}/">{{name}}</a>
      </div>
      <div class="col-xs-4 text-right">
        <a href="#" class="btn btn-link gc-exercises-assign-btn">Schedule</a>
        <a href="#" class="btn btn-link gc-exercises-assign-btn">Enter results</a>
        <a href="#" data-id="{{id}}" class="gc-exercises-assign-btn-del"><span class="fa fa-trash"></span></a>
      </div>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <div class="gc-exercises-assign">
    <div class="gc-exercises-assign-empty">
      <img src="../static/images/icon-weight-large.png" alt=" ">
      <p>No {{assign_name}} currently assigned to this client</p>
      <a href="" class="btn btn-link gc-exercises-assign-add">Add first {{assign_name}}</a>
    </div>
  </div>
  {{/if}}
</div>
