<div class="gc-program-workout-item">
  <div class="gc-workout-header">
    <span class="gc-program-workout-sort"></span>
    <h3 class="gc-workout-title"><span contenteditable=true>{{name}}</span></h1>
    <span class="gc-workout-bookmark"></span>
    <div class="gc-workout-actions">
      <a class="btn btn-primary gc-cheevon-dropdown" data-toggle="dropdown" aria-haspopup="true" role="button" aria-expanded="false">
        <i class="fa fa-chevron-down"></i>
      </a>
      <ul class="dropdown-menu gc-dropdown pull-right" aria-labelledby="gc-workout-actions-dropdown" role="menu">
        <li><a href="#">Add Note</a></li>
        <li><a href="#">Edit Description</a></li>
        <li><a href="#">Add Video</a></li>
        <li><a href="#">Save Workout</a></li>
        <li><a href="#">Duplicate</a></li>
        <li class="gc-danger"><a class="gc-delete-program-workout" href="#">Delete</a></li>
      </ul>
    </div>
  </div>
  <div class="gc-workout-body">
    <ul class="gc-content-nav gc-workout-body-nav">
      <li class="active"><a data-toggle="tab" data-content="description">description</a></li>
      <li class=""><a data-toggle="tab" data-content="video">video</a></li>
      <li class=""><a data-toggle="tab" data-content="warmups">warmups</a></li>
    </ul>
    <div class="tab-content gc-workout-tab-content">
      <div class="tab-pane active" data-pane="description">
        <textarea rows="1" class="gc-program-description-editor gc-description-editor form-control" type="text" placeholder="Start typing a description here..."/>
      </div>
      <div class="tab-pane" data-pane="video">
        <div class="gc-workout-empty-video">
          <p>
            Seems you don’t have any video in your workout.
          </p>
          <p>
            <button class="btn btn-primary gc-custom">Add Video</button>
          </p>
        </div>
      </div>
      <div class="tab-pane" data-pane="warmups">
        <div class="gc-workout-empty-warmups">
          <p>
            Seems you don’t have any warmups in your workout.
          </p>
          <p>
            <a href="#" class="gc-quick-add">Quick Add</a> or <button class="btn btn-primary gc-custom">Add Exercise</button>
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="gc-workout-footer row">
    <div class="col-xs-6">
      <a href="#" class="gc-text-link gc-capitalize">
        <span class="gc-icon-link gc-icon-exercises-add"></span>
        Add Exercise
      </a>
    </div>
    <div class="col-xs-6 text-right">
      <a href="#" class="gc-text-link gc-capitalize">
        <span class="gc-icon-link gc-icon-add-property"></span>
        Add New Property
      </a>
    </div>
  </div>
</div>
