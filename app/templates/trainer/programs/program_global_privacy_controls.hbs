{{#withProfile}}
  {{#ifEqual id ../author.id}}
  <div class="row gc-remove-margin">

    <div class="col-xs-12 gc-program-options gc-add-workout-controls hidden">
      <!--<button class="btn btn-primary btn-sm gc-custom gc-program-add-week">add new week</button>-->
      <div class="gc-add-create-workout-wrapper">
        <div>
          <input class="form-control" />
          <button type="button" class="gc-clear-quick-add gc-cancel-add-workout">cancel</button>
        </div>
        <div>
          or
        </div>
        <div>
          <button class="btn btn-primary btn-sm gc-custom gc-program-create-workout">Create new workout</button>
        </div>
      </div>
    </div>

    <div class="col-xs-12 text-right gc-program-options gc-default-controls">

      <button class="pull-left btn btn-primary btn-sm gc-custom gc-program-add-workout" type="button">add new workout</button>


      <!-- privacy controls -->
      <div class="btn-group gc-btn-group privacy-buttons" data-toggle="buttons">
        <label class="btn btn-primary {{#if ../../is_public}}active{{/if}}">
          <input type="radio" name="privacy" {{#if ../../is_public}}checked{{/if}} value="true" /> Public
        </label>
        <label class="btn btn-primary {{#unless ../../is_public}}active{{/unless}}">
          <input type="radio" name="privacy" value="false" {{#unless ../../is_public}}checked{{/unless}} /> Private
        </label>
      </div>
      <!-- / privacy controls -->

      <button class="btn btn-primary gc-program-delete-button">Delete Program</button>
    </div>
  </div>
  {{/ifEqual}}
{{/withProfile}}
