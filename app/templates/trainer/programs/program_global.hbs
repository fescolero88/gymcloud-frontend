{{#withProfile}}
<div class="gc-main-workspace row">
  <div class="col-xs-12 gc-content-both">
    <div class="gc-clients-nav-wrapper row">
      <div class="col-xs-7 gc-clients-nav-left">
          <a class="gc-content-nav-back">
            <span class="fa fa-chevron-left"></span>
          </a>
          <div class="gc-workout-title">
            <h2 class="gc-program-name" contenteditable=true>{{../name}}</h2>
          </div>
        </div>
        <div class="col-xs-5 gc-exercises-nav-right text-right">
          {{#ifEqual id ../author/id}}
            <ul class="gc-content-nav" >
              <li class="active" data-view="program">
                <a href="#">Program</a>
              </li>
              <li class="" data-view="assign">
                <a href="#">Assign</a>
              </li>
            </ul>

            <!-- /workout tabs -->
              <a class="gc-workout-actions-button btn btn-primary" data-toggle="dropdown" id="gc-workout-actions-dropdown" aria-haspopup="true" role="button" aria-expanded="false">
                <i class="fa fa-chevron-down"></i>
              </a>
              <ul class="dropdown-menu pull-right gc-program-actions-list" role="menu" aria-labelledby="gc-workout-actions-dropdown">
                <li class="row">
                  <a class="col-xs-12 gc-program-add-note">
                    Add Note
                  </a>
                </li>
                <li class="row">
                  <a class="col-xs-12 gc-program-edit-description">
                    Edit Description
                  </a>
                </li>
                <li class="row">
                  <a class="col-xs-12">
                    Add Video
                  </a>
                </li>
                <li class="row">
                  <a class="col-xs-12 text-danger">
                    Delete
                  </a>
                </li>
              </ul>

          {{else}}
            <button class="btn brn-primary gc-add-to-library-button">Add to library</button>
          {{/ifEqual}}
        </div>
      </div>
    </div>

     <div id="program-manage"></div>

  </div>
</div>
{{/withProfile}}
