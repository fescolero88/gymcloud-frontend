<div class="gc-main-workspace row">
  <div class="col-xs-12 gc-content-both">
    <div class="gc-clients-nav-wrapper row">
      <div class="col-xs-7 gc-clients-nav-left">
        <label class="gc-content-nav-checkall">
          <input type="checkbox">
        </label>
        <a class="gc-content-nav-back">
          <span class="fa fa-chevron-left"></span>
        </a>
        <div id="breadcrumbs"></div>
        <a class="btn btn-link gc-show-add-exercise-modal">
          <span class="fa fa-plus"></span>
          Add {{typeSingle}}
        </a>
      </div>
      <div class="col-xs-5 gc-exercises-nav-right text-right">
        <a class="btn btn-link gc-show-add-exercise-folder-modal">
          <span class="fa fa-plus"></span>
          Add folder
        </a>
        <a class="btn btn-link gc-show-duplicate-modal">Duplicate</a>
        <a href="#" id="rm-event" class="btn btn-danger">
          <span class="fa fa-trash"></span>
        </a>
      </div>
    </div>
    <div class="gc-clients-list-wrapper row">
      <div class="gc-exercises-assign">
        <div class="gc-exercises-assign-input-wrapper">
          <input type="text" class="gc-exercises-assign-input form-control live-search" placeholder="Search {{typeSingle}}">
        </div>
      </div>
      <div class="col-xs-12" id="exercises-region"></div>
    </div>
    <div class="gc-global-list-splash hidden">
      <div class="gc-splash-control">
        <div class="gc-splash-description">
          <img src="app/images/icon-folder.png" />
          <p>You dont have <br/> anything inside this folder.</p>
        </div>
        <div class="gc-splash-btn-container">
          <a class="btn btn-link gc-show-add-exercise-modal">
            <span class="fa fa-plus"></span>
            Add {{typeSingle}}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade gc-modal" id="gc-modal-region"></div>
