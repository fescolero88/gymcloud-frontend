{{#if isFolder}}<div class="gc-add-modal-folder">{{else}}<div class="gc-add-modal-item">{{/if}}
  <a class="row {{#if isFolder}}toggle-menu toggle-it{{/if}}" data-key="{{key}}">
    {{#if isFolder}}
      <span class="fa fa-folder-o fa fa-arrows"></span>
      <span class="gc-add-modal-item-name">{{title}}</span>
    {{else}}
      <span class="gc-add-modal-cat-icon" style="background-image:url('../static/images/{{../type}}-single.png')"></span>
      <span class="gc-add-modal-item-name">{{title}}</span>
    {{/if}}
  </a>
  <div class="gc-add-modal-sub">
    {{#each items}}
      {{> add_modal_item type=../type }}
    {{/each}}
  </div>
</div>
