<header class="gc-header-standard gc-header-login">
  <div class="container">
    <div class="col-xs-12 col-sm-6 gc-login-form-wrapper">
      <h1 class="text-center">Enter your personal information</h1>
      <form role="form">
        <div class="row form-group">
          <div class="col-xs-6">
            <label for="InputPassword1">First Name</label>
            <input type="text" class="form-control" id="InputPassword1" placeholder="">
          </div>
          <div class="col-xs-6">
            <label for="InputPassword2">Last Name</label>
            <input type="text" class="form-control" id="InputPassword2" placeholder="">
          </div>
        </div>
        <div class="form-group">
          <label for="InputAddress">Address</label>
          <input type="text" class="form-control" id="InputAddress" placeholder="">
        </div>
        <div class="form-group">
          <label for="InputCity">City</label>
          <input type="text" class="form-control" id="InputCity" placeholder="">
        </div>
        <div class="form-group">
          <label for="InputState">State</label>
          <input type="text" class="form-control" id="InputState" placeholder="">
        </div>
        <div class="form-group">
          <label for="InputZIP">ZIP code</label>
          <input type="text" class="form-control" id="InputZIP" placeholder="">
        </div>
        <div class="form-group">
          <label for="InputDate">Date of Birth</label>
          <input type="date" class="form-control" id="InputDate" placeholder="">
        </div>
        <div class="form-group">
          <div class="row">
            <div class="col-xs-2">
              <label for="r1">Gender</label>
            </div>
            <div class="col-xs-2 col-padding-5">
              <label>
                <input type="radio" value="1" name="gender"> <span>Male</span>
              </label>
            </div>
            <div class="col-xs-3 col-padding-5">
              <label>
                <input type="radio" value="0" name="gender"> <span>Female</span>
              </label>
            </div>
          </div>
        </div>
        <div class="form-group row">
          <div class="col-xs-6">
            <div class="checkbox">
              <label>
                <input type="checkbox">
                <span>
                  I agree with the
                  <br>
                  <a>GymCloud end user agreement</a>
                </span>
              </label>
            </div>
          </div>
          <div class="col-xs-6 text-right">
            <button type="submit" class="btn btn-default">Sign Up</button>
          </div>
        </div>
      </form>
      <p class="gc-login-signup-wrapper text-center">
        Don't have an account? <a href="#">Sign up</a>
      </p>
    </div>
  </div>
</header>
