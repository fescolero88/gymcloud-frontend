<header class="gc-header-standard gc-header-login">
  <div class="container">
    <div class="col-xs-12 col-sm-6 gc-login-form-wrapper">
      <h1 class="text-center">Create a GymCloud Account</h1>
      <form role="form" id="gc-signup-step-1">
        <ul class="gc-trainer-type-wrapper row">
          <li class="col-xs-4">
            <label class="active gc-trainer-type gc-trainer-type-personal">
              <span>
                I'm a
                <br>
                Personal Trainer
              </span>
              <input type="radio" checked name="account_type" value="1">
            </label>
          </li>
          <li class="col-xs-4">
            <label class="gc-trainer-type gc-trainer-type-couch">
              <span>
                I'm a Strength and
                <br>
                Conditioning Coach
              </span>
              <input type="radio" name="account_type" value="2">
            </label>
          </li>
          <li class="col-xs-4">
            <label class="gc-trainer-type gc-trainer-type-not">
              <span>
                I'm not working
                <br>
                with a Fitness
                <br>
                Professional
              </span>
              <input type="radio" name="account_type" value="3">
            </label>
          </li>
        </ul>
        <div class="form-group row gc-login-social">
          <div class="col-xs-12 col-md-6 text-xs-center text-md-left">
            <a class="btn btn-primary" href="#">
              <i class="fa fa-facebook"></i>
              Sign up with Facebook
            </a>
          </div>
          <div class="col-xs-12 col-md-6 text-xs-center text-md-right">
            <a class="btn btn-danger" href="#">
              <i class="fa fa-google-plus"></i>
              Sign up with Google+
            </a>
          </div>
        </div>
        <div class="row gc-signup-with-email-title">
          Or register with your email:
        </div>
        <div class="form-group gc-email-form-group">
          <label for="gc-signup-email">Email address</label>
          <input type="email" name="email" class="form-control" id="gc-signup-email" placeholder="Enter email">
          <label class="gc-error-message"></label>
        </div>
        <div class="row form-group">
          <div class="col-xs-6">
            <label for="gc-signup-password-1">Password</label>
            <input type="password" name="password" class="form-control" id="gc-signup-password-1" placeholder="Password" autocomplete="off">
            <label class="gc-error-message"></label>
          </div>
          <div class="col-xs-6">
            <label for="gc-signup-password-2">Password Confirm</label>
            <input type="password" name="password_confirmation" class="form-control" id="gc-signup-password-2" placeholder="Password" autocomplete="off">
            <label class="gc-error-message"></label>
          </div>
        </div>
        <div class="form-group row">
          <div class="col-xs-12 text-right">
            <button type="submit" class="btn btn-default">Next</button>
          </div>
        </div>
      </form>
      <p class="gc-login-signup-wrapper text-center">
        Have an Gymcloud account? <a href="#login">Sign in</a>
      </p>
    </div>
  </div>
</header>
