<div class="page-wrap">
  <header class="gc-header-standard gc-header-login">
    <div class="container">
      <div class="col-xs-12 col-sm-6 gc-login-form-wrapper">
        <h1 class="text-center">Reset Password</h1>
        <form class="gc-reset-password-form" role="form">
          <p class="gc-forgot-password-text">
            Please enter your new password in a boxes below
          </p>
          <div class="form-group">
            <label for="password-input">New Password</label>
            <input type="password" name="password" class="form-control" id="password-input">
            <label class="gc-error-message"></label>
          </div>
          <div class="form-group">
            <label for="confirm-password-input">Confirm New Password</label>
            <input type="password" name="password_confirmation" class="form-control" id="confirm-password-input">
            <label class="gc-error-message"></label>
          </div>
          <div class="form-group row">
            <div class="col-xs-12 text-right">
              <button type="submit" class="btn btn-default">Submit</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </header>
</div>
