<div class="page-wrap">
  <header class="gc-header-standard gc-header-login">
    <div class="container">
      <div class="col-xs-12 col-sm-6 gc-login-form-wrapper">
        <h1 class="text-center">Forgot your password?</h1>
        <form class="gc-forgot-password-form" role="form">
          <p class="gc-forgot-password-text">
            Please enter your email address below and
            <br>
            we'll email you instructions on how to reset your password.
          </p>
          <div class="form-group">
            <label for="forgotEmail">Email address</label>
            <input type="text" name="email" class="form-control gc-forgot-password-email" id="forgotEmail" placeholder="Enter email">
            <label class="gc-error-message"></label>
          </div>
          <div class="form-group row">
            <div class="col-xs-12 text-right">
              <a class="gc-cancel-forgot-password" href="#login">Cancel</a>
              <button type="submit" class="btn btn-default">Send</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </header>
</div>
