<div class="page-wrap">
  <header class="gc-header-standard gc-header-login">
    <div class="container">
      <div class="col-xs-12 col-sm-6 gc-login-form-wrapper">
        <h1 class="text-center">Sign In to your account</h1>
        <form role="form" class="gc-login-form">
          <div class="form-group row gc-login-social">
            <div class="col-xs-12 col-md-6 text-xs-center text-md-left">
              <span class="btn btn-primary" data-social='fb'>
                <i class="fa fa-facebook"></i>
                Log in with Facebook
              </span>
            </div>
            <div class="col-xs-12 col-md-6 text-xs-center text-md-right">
              <span class="btn btn-danger" data-social='gplus'>
                <i class="fa fa-google-plus"></i>
                Log in with Google+
              </span>
            </div>
          </div>
          <div class="form-group">
            <label for="exampleInputEmail1">Email address</label>
            <input type="text" name="username" class="form-control" id="exampleInputEmail1" placeholder="Enter email">
            <label class="gc-error-message"></label>
          </div>
          <div class="form-group">
            <label for="exampleInputPassword1">Password</label>
            <a href="#forgot-password" class="pull-right forgot-password-link">Forgot password</a>
            <input type="password" name="password" class="form-control" id="exampleInputPassword1" placeholder="Password" autocomplete="off">
          </div>
          <div class="form-group row">
            <div class="col-xs-6">
              <div class="checkbox">
                <label>
                  <input type="checkbox"> Remember Me
                </label>
              </div>
            </div>
            <div class="col-xs-6 text-right">
              <button type="submit" class="btn btn-default">Log in</button>
            </div>
          </div>
        </form>
        <p class="gc-login-signup-wrapper text-center">
          Don't have an account? <a href="/#signup">Sign up</a>
        </p>
      </div>
    </div>
  </header>
</div>

<div class="modal fade gc-modal" id="gc-signup-message">
  <div class="modal-dialog modal-md">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span>Close</span></button>
        <h4 class="modal-title">
          <span>
            <img src="app/images/icon-individuals.png" alt="">
          </span>
          Congratulations!
        </h4>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-xs-12">
            <p>
              Welcome to GymCloud!
              <br>
              Now you can sign in with your email and password.
            </p>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <div class="row">
          <div class="col-xs-12 text-center">
            <button class="btn btn-primary" data-dismiss="modal">Start using GymCLoud</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
