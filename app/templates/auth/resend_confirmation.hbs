<div class="page-wrap">
  <header class="gc-header-standard gc-header-login">
    <div class="container">
      <div class="col-xs-12 col-sm-6 gc-login-form-wrapper">
        <h1 class="text-center">Resend Confirmation Instructions</h1>
        <form class="gc-reset-password-form" role="form">
          <div class="gc-resend-success hidden">
            <p>An email has been sent to your account. Please follow the steps to confirm your account.</p>
          </div>
          <div class="gc-resend-form-controls">
            <div class="row gc-resend-email-container">
              <input type="text" name="email" class="form-control" />
            </div>

            <div class="row gc-resend-button-container">
              <button class="btn btn-primary resend-confirmation" type="button">Resend Instructions</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </header>
</div>
