.modal-content
  .modal-header
    button.close(type='button', data-dismiss='modal')
      span Close
    h4.modal-title
      span
        img(src='app/images/icon-individuals.png', alt='')
      if id
        | Edit #{first_name} #{last_name} information
      else
        | Create a new client
  form.form(role='form')
    .modal-body
      .row
        .col-xs-3.col-padding-5
          .gc-edit-profile-modal-upload-wrapper
            input.gc-edit-profile-modal-upload-input(type='file')
            p.gc-edit-profile-modal-upload-text(href='#')
              span.fa.fa-plus
              | Upload
              br
              | photo
            img.gc-edit-profile-modal-avatar(src="#{avatar_url}", alt=' ')
        .col-xs-9
          .form-group
            .row
              .col-xs-2
                label(for='r1') Gender
              .col-xs-2.col-padding-5
                label
                  input(type='radio', checked=gender=='male', value='male', name='gender')
                  span Male
              .col-xs-3.col-padding-5
                label
                  input(type='radio', checked=gender=='female', value='female', name='gender')
                  span Female
          .row
            .col-xs-4
              .form-group
                label(for='weight') Weight
                input#weight.form-control(name='weight', type='text', value=weight)
                span.gc-valid-icon.fa.fa-check.hide
            .col-xs-4
              .form-group
                label(for='height') Height
                input.form-control(name='height', type='text', value=height)
                span.gc-valid-icon.fa.fa-check.hide
            .col-xs-4
              .form-group
                label(for='bodyfat') Bodyfat
                input.form-control(name='bodyfat', type='text', value=bodyfat)
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-12
              .form-group
                label(for='first_name')
                  | First name 
                  span.gc-req *
                label.gc-error-message
                input.form-control(name='first_name', type='text', value=first_name)
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-12
              .form-group
                label(for='last_name')
                  | Last name 
                  span.gc-req *
                label.gc-error-message
                input.form-control(name='last_name', type='text', value=last_name)
                span.gc-valid-icon.fa.fa-check.hide
          //- .row
          //-   .col-xs-12
          //-     .form-group
          //-       label(for='email')
          //-         | Email 
          //-         span.gc-req *
          //-       label.gc-error-message
          //-       input.form-control(name='email', type='text', value=email)
          //-       span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-8
              .form-group
                label(for='location') Location
                label.gc-error-message
                input.form-control(name='location', type='text', value=location)
                span.gc-valid-icon.fa.fa-check.hide
            .col-xs-4
              .form-group
                label(for='zip') ZIP
                label.gc-error-message
                input.form-control(name='zip', type='text', value=zip)
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-12
              .form-group
                label(for='employer') Employer
                label.gc-error-message
                input.form-control(name='employer', type='text', value=employer)
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-6
              .form-group
                label(for='birthday') Date of birth
                input.form-control(name='birthday', type='date', value=birthday)
                span.gc-valid-icon.fa.fa-check.hide
    .modal-footer
      .row
        .col-xs-12.text-right
          button.btn.btn-primary(type='submit') Save
