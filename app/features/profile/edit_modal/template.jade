.modal-content
  .modal-header
    button.close(data-dismiss='modal')
      span Close
    h4.modal-title
      span
        img(src='app/images/icon-individuals.png', alt='')
      | Edit User Profile
  form.form(role='form')
    .modal-body
      .row
        .col-xs-3.col-padding-5
          .gc-edit-profile-modal-upload-wrapper
            input.gc-edit-profile-modal-upload-input(type='file')
            p.gc-edit-profile-modal-upload-text(href='#')
              span.fa.fa-plus
              | Upload
              br
              | photo
            img.gc-edit-profile-modal-avatar(src=avatar.thumb.url, alt=' ')
        .col-xs-9
          .form-group
            .row
              .col-xs-2
                label(for='r1')
                  | Gender
              .col-xs-2.col-padding-5
                label
                  input(type='radio', value='male', name='gender')
                  span
                    | Male
              .col-xs-3.col-padding-5
                label
                  input(type='radio', value='female', name='gender')
                  span
                    | Female
          .row
            .col-xs-4
              .form-group
                label(for='weight')
                  | Weight
                input#weight.form-control(name='weight', type='text')
                span.gc-valid-icon.fa.fa-check.hide
            .col-xs-4
              .form-group
                label(for='height')
                  | Height
                input.form-control(name='height', type='text')
                span.gc-valid-icon.fa.fa-check.hide
            .col-xs-4
              .form-group
                label(for='bodyfat')
                  | Bodyfat
                input.form-control(name='bodyfat', type='text')
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-12
              .form-group
                label(for='first_name')
                  | First name
                  span.gc-req *
                label.gc-error-message
                input.form-control(
                  name='first_name'
                  type='text'
                  maxlength='20'
                )
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-12
              .form-group
                label(for='last_name')
                  | Last name
                  span.gc-req *
                label.gc-error-message
                input.form-control(
                  name='last_name'
                  type='text'
                  maxlength='20'
                )
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-12
              .form-group
                label(for='email')
                  | Email
                input.form-control(
                  name='email'
                  type='text'
                  disabled
                  maxlength='50'
                )
          .row
            .col-xs-8
              .form-group
                label(for='location')
                  | Location
                label.gc-error-message
                input.form-control(
                  name='location'
                  type='text'
                  maxlength='50'
                )
                span.gc-valid-icon.fa.fa-check.hide
            .col-xs-4
              .form-group
                label(for='zip')
                  | ZIP
                label.gc-error-message
                input.form-control(
                  name='zip'
                  type='text'
                  maxlength='10'
                )
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-12
              .form-group
                label(for='employer')
                  | Employer
                label.gc-error-message
                input.form-control(
                  name='employer'
                  type='text'
                  maxlength='50'
                )
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-6
              .form-group
                label(for='birthday')
                  | Date of birth
                input.form-control(name='birthday', type='date')
                span.gc-valid-icon.fa.fa-check.hide
          .row
            .col-xs-6
              .charge-block
                .charge-sum
                  span
                    | $ &nbsp;
                  | 2.99
                .charge-notice
                  | Charge client for services
            .col-xs-6
              .charge-block
                .charge-sum
                  span
                    | $ &nbsp;
                  | +2.99
                .charge-notice
                  | Add to my subscription payment
          br
    .modal-footer
      .row
        .col-xs-12.text-right
          button.btn.btn-primary(type='submit')
            | Save
