.gc-layout-main
  display: flex
  flex-flow: row wrap
  height: 100%

.gc-topbar
  flex: 1 100%

.gc-sidebar-wrapper
  flex: 1
  display: flex
  min-width: 230px
  background: #282d30
  overflow: auto
  align-items: flex-start

.gc-main
  position: relative
  height: 100%
  background-color: #fff
  display: flex
  flex-direction: column
  flex: 8
  padding: 0 15px

.gc-main > div
  height: 100%
  position: relative
