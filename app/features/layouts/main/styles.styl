.gc-layout-main
  display: flex
  flex-flow: row wrap
  height: 100%

  region[data-name='header'],
  .gc-topbar
    flex: 1 0 100%

.gc-sidebar-wrapper
  flex: 1 0 0%
  display: flex
  min-width: 230px
  background: #282d30
  overflow: auto
  align-items: flex-start

.gc-main
  position: relative
  height: 100%
  background-color: #fff
  display: flex
  flex-direction: column
  flex: 8 0 0%
  padding: 0 15px

.gc-main > div
  height: 100%
  position: relative
