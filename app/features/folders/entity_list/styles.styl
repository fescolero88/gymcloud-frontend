.gc-folders-entity-list
  padding: 0
  min-height: 250px
  position: relative

  .gc-folder, .gc-folder-item
    list-style-type: none
    border-bottom: 1px solid #ededed
    padding: 15px

    &:hover
      background: #fbfbfb

    &.active
      background: rgba(51, 152, 219, 0.1)

    &.padding-0
      padding: 0

  .gc-exercises-link
    color: #3a99d8
    text-transform: uppercase
    font-size: 14px
    line-height: 30px
    margin: 0
    display: inline-block

  .gc-exercises-link:hover,
  .gc-exercises-link:active,
  .gc-exercises-link:focus
    color: #282d30
