.row
  .col-xs-12
    .form-group
      if isAuthor
        textarea.gc-workout-description-editor.gc-description-editor.form-control(type='text', placeholder='Start typing a description here...', data-bind='description')
      else
        .gc-workout-description(type='text', placeholder='Start typing a description here...', data-bind='description')
    .gc-workout-video(class=!video_url && 'hidden')
      iframe(width='352', height='198', src=video_url, frameborder='0', allowfullscreen='')
      .row.gc-workout-video-controls
        .col-xs-6
          a.gc-workout-video-link(href=video_url, target='_blank')
            = name
            i.gc-video-icon(class="gc-video-#{videoType}-icon")
            span
              = _.capitalize(videoType)
        .col-xs-6.text-right
          button.btn.btn-link.gc-workout-video-delete
            | Delete
    // Note Fields
    .form-group.gc-workout-note-container(class=hasNote ? '' : 'hidden')
      label.gc-workout-notes-label
        | Workout Notes
      if isAuthor
        textarea.gc-workout-note-editor.gc-note-editor.form-control(type='text', placeholder='Start typing a description here...', data-bind='note')
      else
        .gc-workout-description(type='text', placeholder='Start typing a description here...', data-bind='note')
    // / Note Fields
#gc-exercises-list-region
if isAuthor
  .row
    .col-xs-6
    .col-xs-6.text-right
      region#gc-privacy-button-region(data-name="privacy-buttons")
      button.btn.btn-primary.gc-workout-delete-button
        | Delete workout
.row
  .col-xs-12
    .form-group