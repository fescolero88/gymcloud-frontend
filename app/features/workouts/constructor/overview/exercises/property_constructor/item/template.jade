.btn-group.clearfix.gc-property.editable
  button.btn.btn-sm.btn-primary.gc-custom(type='button')
    i.gc-icon-bars
    span.gc-property-value(contenteditable='true')
  .btn-group(role='group')
    button.btn.btn-sm.btn-primary.gc-custom.dropdown-toggle(type='button', data-toggle='dropdown')
      span.gc-selected-property=defaultProperty
      i.fa.fa-sort
    ul.dropdown-menu.gc-dropdown
      each property in properties
        li
          a.gc-property-item(href='#', data-id=property.id)=property.name
  button.btn.btn-sm.btn-primary.gc-custom.gc-remove(type='button')
    | ×