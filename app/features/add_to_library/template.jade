.modal-dialog.modal-md
  .modal-content.gc-remove-modal
    .modal-header
      button.close(type='button', data-dismiss='modal')
        span
          | Close
      h4.modal-title
        span
          img(src='app/images/add-to-library-icon.png', alt='')
        | Add to library
    form.form.group-form(role='form')
      #gc-modal-library-region.modal-body
      .form-group.gc-add-modal-actions-wrapper
        .input-group
          .input-group-addon.gc-add-modal-input-type-wrapper
            span.gc-add-modal-input-type(class="fix-bg-img-#{type}")
          input.form-control.gc-new-item-name-input(type='text', readonly=true, placeholder="Enter name of #{typeNameSingle} here", value=name)
          .input-group-addon.gc-add-modal-submit-wrapper
            button.btn.btn-primary(type='submit')
              | Add
          span.gc-error-message