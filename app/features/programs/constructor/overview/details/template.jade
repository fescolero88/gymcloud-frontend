.col-xs-8
  .form-group.gc-program-description-container
    if isAuthor
      textarea.gc-program-description-editor.gc-description-editor.form-control(type='text', placeholder='Start typing a description here...', data-bind="description")
    else
      .gc-program-description(type='text', placeholder='Start typing a description here...', data-bind="description")

  .form-group.gc-program-note-container(class= !hasNote && 'hidden')
    label.gc-notes-label
      | Program Notes
    if isAuthor
      textarea.gc-program-note-editor.gc-note-editor.form-control(type='text', placeholder='Start typing your description here...', data-bind="note")
    else
      .gc-program-description(type='text', placeholder='Start typing your note here...', data-bind="note")
.col-xs-4
  .gc-block-group.clearfix.gc-program-counter
    .gc-block
      .gc-block-highlight.gc-program-weeks-count
        = weeksCount || 0
      label
        | weeks
    .gc-block
      .gc-block-highlight.gc-program-workout-count
        = workoutCount || 0
      label
        | workouts