.gc-comment-enter-message
  float: right
  width: 96%
  margin-top: 30px
  padding: 15px 20px 30px
  border: 1px solid #d0d8db
  border-radius: 5px
  background-color: #fff

  textarea
    resize: none
    float: left
    width: 85%
    border: 0
    outline: none

  button[type='submit']
    position: relative
    padding-left: 25px
    padding-right: 25px

    &:after
      content: 'or press  ⏎'
      position: absolute
      top: 35px
      left: 3px
      display: block
      color: #a3afb4
      font-size: 12px
      text-transform: none