.gc-video-player
  .gc-video-preview
    a.gc-video-play(href="#")
  .gc-video-details
    h5.gc-video-title
      | #{name}
    span.gc-video-report
    div
      span.gc-video-timer
        i.gc-video-time-icon
        span
          | #{duration}
      span.gc-video-type
        i.gc-video-icon
        span
          | #{filter}
    button.btn.btn-primary.gc-custom.btn-block.btn-sm.gc-assign-video(
      class=(isAssigned && 'assigned'),
      type="button"
    )
      if isAssigned
        | assigned
      else
        | assign this video