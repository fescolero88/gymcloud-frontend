.popover.tour
  .arrow
  .order
    = id + 1
  h3.popover-title
    = title
  button.btn.btn-default(data-role='end')
    | X
  .popover-content
    = content
  a.docs(target='_blank', href="http://gymcloud.freshdesk.com/solution/articles/#{docs}")
    | Got any docs?
  .popover-navigation
    button.btn.btn-default(data-role='prev')
      | Prev
    button.btn.btn-default(data-role='next')
      | Next
