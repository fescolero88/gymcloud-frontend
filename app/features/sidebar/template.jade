a.gc-sidebar-logo(href='#welcome')
  img(src='app/images/gymcloud-logo.png', alt='')

.nano

  .nano-content.gc-sidebar-content

    .gc-assign-catch(style='min-height: 50px;')

    .gc-sidebar-menu-list

      .gc-sidebar-cat
        a.row.toggle-menu(href='#welcome')
          span.col-xs-2
            span.gc-sidebar-cat-icon.fix-bg-img-icon-dashboard
          span.col-xs-10.gc-sidebar-cat-name
            | Dashboard

      region(data-name='pro')
      region(data-name='workout_exercises')
      region(data-name='personal_workouts')
      region(data-name='personal_programs')

      //-if !isPro
        .gc-sidebar-cat
          a.row.toggle-menu(href='#calendar/')
            span.col-xs-2
              span.gc-sidebar-cat-icon.fix-bg-img-icon-calendar
            span.col-xs-10.gc-sidebar-cat-name
              | Calendar
