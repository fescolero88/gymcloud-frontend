.gc-video-assigned
  width: 352px
  height: 198px

  .gc-video-controls
    margin: 15px 0
    max-height: 25px

    .btn-link + .btn-link
      margin-left: 10px

    > div
      padding: 0px

    .gc-video-link
      font-size: 13px
      color: #747474
      display: inline-block
      text-decoration: none

      span
        &.name
        &.type
          color: #cacaca

      > i
        margin: 0 5px

      &:hover,
      &:active
        color: #747474
        text-decoration: none

    .gc-video-delete
      color: #ee6d5d
      padding: 0

      &:hover,
      &:active,
      &:focus
        background: transparent
        text-decoration: none
        color: #ee6d5d

.gc-video-assigned-placeholder
  background: #f9f9f9
  padding: 30px 15px

  .placeholder-icon
    background: #fefefe
    border-radius: 100px
    height: 78px
    width: 78px
    text-align: center
    color: #3a99d8
    font-size: 30px
    line-height: 84px
    margin: 0 auto 15px
    padding-left: 5px

  p
    color: #c1c1c1
    font-size: 14px
    line-height: 16px
    margin-bottom: 15px

  .btn
    border-radius: 50px
    font-size: 12px
    color: #3a99d8
    text-transform: uppercase
    background: transparent
    border-color: #3a99d8
    border-radius: 50px
    text-align: center
    line-height: 16px
