.gc-workout-header.draggable-handle
  span.gc-program-workout-sort.draggable-handle
  h3.gc-workout-title
    span(contenteditable='true')
    label
      input.hidden(type='checkbox')
      span.gc-workout-bookmark
  .gc-workout-actions
    a.btn.btn-primary.gc-cheevon-dropdown(data-toggle='dropdown', aria-haspopup='true', role='button', aria-expanded='false')
      i.fa.fa-chevron-down
    ul.dropdown-menu.gc-dropdown.pull-right(aria-labelledby='gc-workout-actions-dropdown', role='menu')
      li
        a(href='#', data-action='save_in_library')
          | Save Workout
      li
        a(href='#', data-action='duplicate')
          | Duplicate
      li.gc-danger
        a.gc-delete-program-workout(href='#')
          | Delete
.gc-workout-body
  ul.gc-content-nav.gc-workout-body-nav
    li.active
      a(data-toggle='tab', data-content='description')
        | description
    li
      a(data-toggle='tab', data-content='video')
        | video
    //- li
      a(data-toggle='tab', data-content='warmups')
        | warmups
  .tab-content.gc-workout-tab-content
    .tab-pane.active(data-pane='description')
      region(data-name='editable_textarea')
    .tab-pane(data-pane='video')
      region(data-name='video_assigned')
    //- .tab-pane(data-pane='warmups')
      .gc-workout-empty-warmups
        p
          | Seems you don’t have any warmups in your workout.
        p
          a.gc-quick-add(href='#')
            | Quick Add
          | or
          button.btn.btn-primary.gc-custom
            | Add Exercise
  region(data-name='workout_exercises')
