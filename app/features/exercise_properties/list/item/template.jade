.gc-property-edit.btn-group.clearfix.pull-right.gc-property.editable(class=editMode ? '' : 'hidden')
  button.btn.btn-sm.btn-primary.gc-custom
    i.gc-icon-bars
    span.gc-property-value(contenteditable='true')
  region.select-box(data-name="properties_select_box")
  button.btn.btn-sm.btn-primary.gc-custom.gc-save
    i.glyphicon.glyphicon-ok
  button.btn.btn-sm.btn-primary.gc-custom.gc-remove
    | ×
.gc-property-view.gc-workout-exercise-prop(class=editMode ? 'hidden' : '')
  a.gc-toggle-edit-mode(href='#')
    .btn-group.gc-property-view.gc-property(role='group')
      button.btn.btn-sm.btn-primary.gc-custom.gc-property-label
        i.gc-icon-bars
        | &nbsp;
        span.gc-property-value-name-label
          | #{personal_property.name}: #{value} #{personal_property.global_property.unit}
      button.gc-remove.btn.btn-sm.btn-primary.gc-custom
        i.glyphicon.glyphicon-remove
