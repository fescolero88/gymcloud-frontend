.gc-property-view

  .glyphicon-remove
    height: 15px
    width: 13px
    visibility: hidden

  .gc-remove
    background: none
    padding: 5px 10px
    font-size: 12px
    color red

  .gc-property-label
    border-right: 0

  .gc-property-label > span
    margin-right: -10px

  &:hover
    border-color #3a99d8

    .glyphicon-remove
      visibility: visible
      color: red
