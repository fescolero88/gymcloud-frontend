.gc-content-nav-wrapper
  height: 50px
  border-bottom: 1px solid rgba(40,45,48,0.1)
  margin: 0

  > div
    padding: 0 5px

.gc-content-nav
  padding: 0
  margin: 0
  height: 50px
  display: inline-block

  li
    display: inline-block

    + li
      margin-left: 3px

    a, span
      display: block
      font-size: 18px
      text-transform: uppercase
      color: #9ea0a1
      line-height: 44px
      padding: 2px 4px
      border-bottom: 0px solid #3a99d8

    a
      &:hover
        color: #3a99d8
        border-bottom-width: 2px

    &.active
      a, span
        color: #3a99d8
        border-bottom-width: 2px

.gc-content-nav-checkall
  padding: 10px
  width: 35px
  height: 35px
  margin: 0
  cursor: pointer

  input
    margin: 0
    cursor: pointer

.gc-content-nav-actions

  .gc-content-nav-wrapper > &
    padding: 11px 5px 0 0

    .btn-group

      .btn

        &,
        &:first-child,
        &:last-child
          border-radius: 50px
          background: transparent
          border-radius: 50px
          outline: none
          font-size: 16px
          height: 27px
          width: 27px
          line-height: 25px
          padding: 0
          text-align: center

  .btn

    &:hover, &:focus, &:active
      outline: none

    + .btn
      margin-left: 10px

  .btn-danger
    color: #ee6d5d
    border-color: #ee6d5d

.gc-content-nav-wrapper .gc-content-nav-actions .btn-group .btn.btn-danger:hover
  background: #ee6d5d
  color: #fff

.gc-content-nav-actions .btn-primary
  color: #5b9be6
  border-color: #5b9be6

.gc-content-nav-wrapper .gc-content-nav-actions .btn-group .btn.btn-primary:hover
  background: #5b9be6
  color: #fff

.gc-content-nav-actions .btn .fa
  line-height: 27px

.gc-content-nav-back

  .gc-content-nav &
    margin-left: -15px

    a
      color: #3a99d8

      &:hover
        cursor: pointer

  .gc-clients-nav-left &
    color: #3a99d8
    display: inline-block
    margin: -2px 0 0 10px

    &:hover
      cursor: pointer

@media (min-width: 1025px)

  .gc-content-nav li a
    padding: 2px 7px

@media (min-width: 992px)

  .gc-content-nav
    padding: 0 15px 0 15px

  .gc-content-nav-wrapper

    > div
      padding: 0 15px

    > .gc-content-nav-actions
      padding: 11px 30px 0 0
