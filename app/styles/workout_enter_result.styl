.gc-workout-enter-bottom-btns
  display: flex
  justify-content: space-between
  margin: 44px 0

.gc-comment-box
  padding: 40px 25px 40px 0

  .gc-comment-avatar
    display: block
    float: left
    width: 40px
    height: 40px
    border-radius: 50%
    background: #b8c84b url('../images/avatar-black-placeholder.png') no-repeat center center

    img
      display: inline-block
      width: inherit
      height: inherit

    img[src='']
      display: none

  .gc-comment-right-section
    overflow: hidden
    padding-left: 20px

  .gc-comment-message
    position: relative
    padding: 20px 20px 40px
    background-color: #fff
    border: 4px solid #fff

    &:after
      left: -22px
      top: 50%
      border: solid transparent
      content: ''
      height: 0
      width: 0
      position: absolute
      pointer-events: none

    &:after
      border-color: rgba(255, 255, 255, 0)
      border-right-color: #fff
      border-width: 9px
      margin-top: -33px

  .gc-comment-date
    margin-top: 10px
    font-size: 13px
    color: #d2d6d9
