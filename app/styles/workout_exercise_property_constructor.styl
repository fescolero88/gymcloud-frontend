.gc-workout-exercise-property-constructor

  a.gc-btn-plus
    margin-top: 11px
    margin-right: 10px
    cursor: pointer

  .gc-assign-property
    margin-top: 8px
    margin-right: 10px

.gc-workout-exercise-property-list
  padding: 8px!important
  padding-right: 10px

  li
    display: inline

    .gc-property
      margin: 0!important

    .gc-selected-property
      padding 0 8px 0 0

span.gc-property-value
  min-width: 16px
  display: inline-block

.gc-constructor-empty-state
  color: #ccc
  size: 14px
  margin-top: 13px

.gc-property-view

  .gc-icon-trash
    height: 15px
    width: 13px
    visibility: hidden

  .gc-remove
    background: none
    padding: 5px 10px
    font-size: 8px

  .gc-property-label
    border-right: 0

  .gc-property-label > span
    margin-right: -10px

  &:hover

    .gc-icon-trash
      visibility: visible
