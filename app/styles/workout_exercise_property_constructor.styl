.gc-workout-exercise-property-constructor

  a.gc-btn-plus
    margin-top: 11px
    margin-right: 10px
    cursor: pointer

  .gc-assign-property
    margin-top: 8px
    margin-right: 10px

.gc-workout-exercise-property-list
  padding: 8px!important
  padding-right: 10px

  li
    display: inline
    margin-right 7px

    .gc-property
      margin: 0!important


span.gc-property-value
  min-width: 16px
  display: inline-block
  outline none

.gc-constructor-empty-state
  color: #ccc
  size: 14px
  margin-top: 13px

.gc-property-view

  .glyphicon-remove
    height: 15px
    width: 13px
    visibility: hidden

  .gc-remove
    background: none
    padding: 5px 10px
    font-size: 12px
    color red

  .gc-property-label
    border-right: 0

  .gc-property-label > span
    margin-right: -10px

  &:hover
    border-color #3a99d8

    .glyphicon-remove
      visibility: visible
      color: red

.gc-selected-property
      padding 0 8px 0 0

.gc-workout-exercises-list
  .gu-transit
    position: relative
    display: table
    width: 100%
    background-color: rgba(58,153,216,0.5)
    opacity: 1
    height: 40px

    a
      display: none

    &:not([data-category='exercises'])
      display: none

    &:before
      position: absolute
      top: 5px
      left: 5px
      bottom: 5px
      right: 5px
      content: 'drop exercise here'
      text-transform: uppercase
      text-align: center
      border: 1px dashed #fff
      color: #fff
      line-height: 27px
