.gc-remove-margin.row
  margin: 0

.gc-program-description-container
  padding: 15px 0

.gc-program-empty-placeholder
  min-height: 400px
  width: 100%
  padding: 5px

.gc-program-options
  padding-top: 10px
  padding-bottom: 10px

.gc-program-empty-icon
  height: 38px
  width: 40px
  color: #3a99d8
  margin: 110px auto 15px auto
  background-image: url(../images/workouts-single.png)
  background-repeat: no-repeat
  background-size: contain
  background-position: center
  opacity: 0.8

.gc-program-empty-placeholder p
  color: #c1c1c1
  font-size: 14px
  line-height: 16px
  margin-bottom: 17px

.gc-program-empty-placeholder .btn
  border-radius: 50px
  font-size: 12px
  color: #3a99d8
  text-transform: uppercase
  background: transparent
  border-color: #3a99d8
  border-radius: 50px
  text-align: center
  line-height: 16px
  margin-top: -5px

.gc-program-delete-button
  border-radius: 50px
  font-size: 12px
  color: #ee6d5d
  text-transform: uppercase
  background: #fff
  border-color: #ee6d5d
  border-radius: 50px
  text-align: center
  line-height: 16px

.gc-program-delete-button:hover,
.gc-program-delete-button:active,
.gc-program-delete-button:focus
  border-color: #ee6d5d
  background-color: #ee6d5d

.gc-programs-weeks-list-container
  padding: 10px

.gc-programs-weeks-list-container .gc-program-week-item
  border: 1px solid rgba(40,45,48,0.1)
  padding: 10px
  border-radius: 5px
  background-color: #F9F9F9
  margin-bottom: 20px

.gc-program-week-item .gc-program-week-title
  font-size: 18px
  color: #9ea0a1
  line-height: 22px
  font-weight: bold
  margin: 5px 0 10px
  color: #757575

.gc-program-week-item .gc-program-weeks-workouts-container
  border-radius: 5px
  background-color: #F9F9F9

.gc-program-weeks-workouts-container .gc-program-workouts-list
  padding: 0px

.gc-week-workouts-empty
  text-align: center

  .quick-add
    padding: 0
    text-transform: none
    font-size: 13px

  .gc-exercises-assign-input-wrapper
    text-align: left

.gc-program-week-item .gc-program-week-actions
  list-style-type: none
  margin: 0
  padding: 0
  text-align: right

.gc-program-week-actions
  display: none

.gc-program-week-actions li
  padding: 0
  display: inline-block
  font-size: 20px
  color: #BDBDBD
  vertical-align: middle

.gc-program-week-actions li button
  outline: none
  background-color: transparent
  border: none
  padding: 0 2px
  cursor: pointer

.gc-program-week-item:hover .gc-program-week-actions
  display: block

.gc-program-week-actions li.gc-week-remove-container
  margin-top: -2px

.gc-program-counter
  display: inline-block
  float: right

.gc-workout-draggable.gu-mirror
  background-color: #fff
  border-radius: 6px

.gc-program-add-workout,
.gc-add-workout
  margin-right: 5px

.gc-nav-wrapper.program
  height: 65px
  background-color: #F9F9F9
  z-index: 3

.gc-main-workspace .gc-workspace-content.program
  top: 110px
  height: calc(100% - 179px)

.program-action-panel
  margin: 0
  display: flex

  > div
    align-self: center

  .selectize-input,
  .selectize-input.focus
    border-radius: 19px
    padding-top: 9px
    padding-left: 19px
    height: 38px

  .selectize-dropdown
    margin-top: 6px
    margin-left: 19px
    max-width: calc(100% - 38px)

  .quick-add
    display: none!important

  .counters
    display: flex
    flex-direction: row
    // .gc-nav-wrapper.program -1px border -paddings
    height: calc(65px - 1px - 1.1em)

  .counter-group
    width: 210px
    display: flex
    flex-direction: row
    justify-content: flex-start

    .counter,
    .counter-name
      align-self: center
      color: #797979

    .counter
      font-size: 31px
      margin-right: 10px
      transition: color .3s ease;

      &.highlight
        color: #3a99d8

    .counter-name
      font-size: 15px
      text-transform: uppercase

    button
      align-self: center
      height: 27px
      font-size: 12px
      padding: 0 12px
      background: transparent

      &:hover
        background: #3a99d8

  .widgets
    display: flex

    region
      display: flex
      height: calc(65px - 1px - 1.1em)

      > div,
      > span
        flex-direction: row
        align-self: center

    .gc-author-widget
      padding: 0