.gc-calendar-activity
  margin: 0
  padding: 15px 0 0 0

  li
    margin: 0 0 10px 0
    list-style-type: none
    position: relative

.gc-description-editor,
.gc-note-editor
  border: 1px dashed transparent
  box-shadow: none
  color: #333
  font-size: 14px
  resize: vertical
  height: 2.5em
  max-height: 15em
  resize: none

.gc-description-editor

  textarea.&
    &:hover
      border-color: #3a99d8
      cursor: pointer

  &::-webkit-input-placeholder,
  &:-moz-placeholder,
  &::-moz-placeholder,
  &:-ms-input-placeholder
    color: #999
    opacity: 1

textarea.gc-description-editor:focus,
.gc-note-editor.focus-state
  box-shadow: none
  outline: none
  border-color: #3a99d8
  -webkit-box-shadow: inset 0 1px 1px rgba(0,0,0,.075),0 0 8px rgba(102,175,233,.6)
  box-shadow: inset 0 1px 1px rgba(0,0,0,.075),0 0 8px rgba(102,175,233,.6)

li.gu-mirror
  list-style-type none

.gc-folder .gu-transit
  display none

.gc-folder.gc-folder-droppable-state
  border 1px dashed #3a99d8!important
  background-color rgba(58,153,216,0.2)

.gc-assign-video-upload
  margin-left 0px
  margin-right 0px

  .gc-upload-video
    margin 2px 0px
    padding 5px 20px
    i.gc-icon
      height: 15px;
      width: 20px;
      float: left;
      margin-top: 1px;

.gc-assign-video-filter
  border-bottom none!important

.gc-main-workspace
  position relative

  .gc-workspace-content
    position absolute
    top 50px
    bottom 0
    left 0
    overflow auto
    width 100%

    .gc-folder-search-container
      margin 25px 0 10px 0
      padding 0 20px

.gc-client-list
  height: auto
  position: absolute
  overflow: auto
  top: 184px
  bottom: 0
  left: 0
  right: 0

.gc-clientpage-exercises
  max-height 100%
  overflow auto
