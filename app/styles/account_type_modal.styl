.account-type-list-region

  ul
    list-style-type: none
    margin: 0
    padding: 0

  .gc-account-type-item
    padding: 5px
    border: 1px solid #ededed
    border-radius: 4px
    margin-bottom: 10px
    cursor: pointer

    &.active
      border-color: #3a99d8
      box-shadow: inset 0 0 4px #3a99d8

  .gc-account-selected
    margin: 4px 0
    display: none

    i
      margin: 5px 3px 5px

    &.assigned
      display: block

  .gc-account-type-image
    width: 36px
    height: 33px
    display: inline-block

  .gc-account-title
    padding: 0

.gc-enveloper-icon
  background-image: url('../images/enveloper-icon.png')
  display: inline-block
  width: 26px
  height: 26px
  background-repeat: no-repeat
  background-position: center
  float: left

.gc-acc-personal-trainer
  background-image: url('../images/personal-trainer.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-str-conditioning
  background-image: url('../images/strength-conditioning.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-athletic-trainer
  background-image: url('../images/athletic-trainer.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-physical-therapist
  background-image: url('../images/physical-therapy.png')
  background-size: cover
  background-repeat: no-repeat
