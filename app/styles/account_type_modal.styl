.account-type-list-region

  ul
    list-style-type: none
    margin: 0
    padding: 0

  .gc-account-type-item
    padding: 8px 5px 4px
    border: 1px solid #ededed
    border-radius: 4px
    margin-bottom: 10px
    cursor: pointer

    &.active
      border-color: #3a99d8
      box-shadow: inset 0 0 4px #3a99d8

  .gc-account-selected
    margin: 4px 40px
    display: none
    float: right

    i
      margin: 5px 3px 5px

    &.assigned
      display: block

  .gc-account-type-image
    width: 36px
    height: 33px
    display: inline-block

  .gc-account-title
    padding: 0

.gc-enveloper-icon
  background-image: url('../images/icon-preset.png')
  display: inline-block
  width: 78px
  height: 54px
  background-repeat: no-repeat
  background-position: center
  float: left
  margin: 18px 13px 0 15px

.gc-acc-personal-trainer
  background-image: url('../images/personal-trainer.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-str-conditioning
  background-image: url('../images/strength-conditioning.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-athletic-trainer
  background-image: url('../images/athletic-trainer.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-physical-therapist
  background-image: url('../images/physical-therapy.png')
  background-size: cover
  background-repeat: no-repeat
  
.account-type-header
  height: 73px
  padding: 0

.account-type-title
    font-size 16px !important
    margin-top 25px
  
.account-type-body
  padding: 44px 55px 0 !important

.gc-account-icon
    margin-left: 4px
    

.account-type-descr
  display block
  margin-top: 20px
  margin-left: 30px
  margin-bottom: 36px
  text-align: left
  color: grey
  

.gc-change-account-type
  display: inline-block
  padding: 7px 70px 7px

.account-type-footer
  text-align center
  margin-bottom: 40px

.account-type-modal
  width: 550px
    
.account-type-select
  width: 29px
  height: 29px
  background: url('../images/select-acc.png')
  