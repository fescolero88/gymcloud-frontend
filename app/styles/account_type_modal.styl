.account-type-list-region

  ul
    list-style-type: none
    margin: 0
    padding: 0

  .gc-account-type-item
    padding: 8px 5px 8px
    border: 1px solid #ededed
    border-radius: 4px
    margin-bottom: 10px
    cursor: pointer

    &.active
      border-color: #3a99d8
      box-shadow: inset 0 0 4px #3a99d8

  .gc-account-selected
    margin: 4px 40px
    display: none
    float: right

    i
      margin: 5px 3px 5px

    &.assigned
      display: block

  .gc-account-type-image
    width: 36px
    height: 33px
    display: inline-block

  .gc-account-title
    padding: 0

.gc-enveloper-icon
  background-image: url('../images/icon-preset.png')
  display: inline-block
  width: 78px
  height: 54px
  background-repeat: no-repeat
  background-position: center
  float: left
  margin: 18px 13px 0 15px

.gc-acc-personal-trainer
  background-image: url('../images/personal-trainer.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-str-conditioning
  background-image: url('../images/strength-conditioning.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-athletic-trainer
  background-image: url('../images/athletic-trainer.png')
  background-size: cover
  background-repeat: no-repeat

.gc-acc-physical-therapist
  background-image: url('../images/physical-therapy.png')
  background-size: cover
  background-repeat: no-repeat
  
.account-type-header
  height: 73px
  padding: 0

.account-type-title
    font-size 16px !important
    margin-top 25px
  
.account-type-body
  padding: 44px 55px 0 !important

.gc-account-icon
    margin-left: 4px
    

.account-type-descr
  display block
  margin-top: 20px
  margin-left: 30px
  margin-bottom: 36px
  text-align: left
  color: grey
  

.gc-change-account-type
  display: inline-block
  padding: 7px 70px 7px

.account-type-footer,
.account-preset-footer
  text-align center
  margin-bottom: 40px

.account-preset-footer
  padding: 50px 55px 15px !important
  
  span
    display: block
    text-align: left
    color: #808080
  
    &:last-of-type
      margin-bottom: 40px

.account-type-modal
  width: 550px
    
.account-type-select
  width: 29px
  height: 29px
  background: url('../images/select-acc.png')

.gc-account-preset-select
  padding-left: 31px

.gc-account-preset-title
  text-align: center
  margin-bottom: 40px
  font-size: 19px

.gc-account-preset-body
  padding: 30px 55px 0 !important

.gc-preset-prev-btn
  border: none !important

.gc-preset-next-btn
  padding-right: 22px !important
  padding-left: 22px !important

.account-preset-close
  margin-top 30px !important
  margin-right 25px !important