                      | March.21
                    td
                      | 1:46 PM
                  tr
                    td
                      a(href="#").performed-workout-link
                        | Cable Crunch
                    td
                      | March.22
                    td
                      | 5:00 PM
                  tr
                    td.with-load-btn(colspan="3")
                      a.load-more-content(href="#")
                        | Load more...

            .tab-content(id='completed-this-week')
              .table-container
                table
                  tr
