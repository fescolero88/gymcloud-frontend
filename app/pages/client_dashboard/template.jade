.gc-workspace-content
  .gc-dashboard
    header.gc-dashboard-header.client
      .trainer-info
        span.trainer-label
          | Trainer:
        a.trainer-link(href="#")
          | Alex Smithson
        button.btn.btn-default.trainer-message-btn
          | Message trainer
      a(href="#")
        img(src="https://gymcloudstaging.s3.amazonaws.com/uploads/user_profile/avatar/556/thumb_1.jpg?AWSAccessKeyId=AKIAJKLC7C67JNL3ZZEQ&Expires=1469792427&Signature=TY6uDsE9NMZVIUK4OdUtYLPsze8%3D", alt="").trainer-avatar
    .gc-dashboard-content
      .dashboard-left-side
        .top-section.clearfix
          .workout-indicators
            .gc-workout-indicator.client
              svg(viewbox='0 1 10 9')
                path.stroke.default(d='M2 8 A 4 4 0 1 1 8 8')
                //- For managing progress, change first number in stroke-dasharray:
                path.stroke.progress(d='M2 8 A 4 4 0 1 1 8 8', style='stroke-dasharray: 15 20')
                .content
                  span.counter
                    | 4/5
                  span.counter-text
                    | Workouts completed this week
          .gc-workout-calendar
            header.header
              i.workout-icon
              .workout-info
                span.title
                  | Next Workout:
                span.workout-date
                  b
                    | Mar 19 
                  | at
                  b 
                    | 17:00 PM
            .content
              span.title
                | Workout
              a.workout-link(href="#")
                | Upperbody workout

        .gc-dashboard-table
          header.header
            button.tab-link.active
              | Workouts scheduled this week
            button.tab-link
              | Workouts completed this week
          .content
                        
