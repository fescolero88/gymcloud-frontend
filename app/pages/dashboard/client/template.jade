.gc-dashboard
  header.gc-dashboard-header
    h1.title
      | Dashboard
    .right-section
      region(data-name='trainer_info')
  .gc-dashboard-content
    .dashboard-left-side
      .top-section.clearfix
        .workout-indicators
          region(data-name='completion_ring', style='display:block;')
        .gc-workout-calendar
          region(data-name='scheduled_workout_slider')

      .gc-dashboard-table
        header.header
          button.tab-link.active
            | Workouts scheduled this week
          button.tab-link
            | Workouts completed this week
        .content

          .tab-content.hidden(id='scheduled-this-week')
            .table-container
              table
                tr
                  th
                    | Workout
                  th
                    | Date
                  th
                    | Time
                tr
                  td
                    a(href="#").performed-workout-link
                      | Cable Crunch
                  td
                    | Tommorow
                  td
                    | 5:00 PM
                tr
                  td
                    a(href="#").performed-workout-link
                      | Upperbody workout
                  td
                    | March.20
                  td
                    | 2:33 PM
                tr
                  td
                    a(href="#").performed-workout-link
                      | Strength week 1/2
                  td
                    | March.21
                  td
                    | 1:46 PM
                tr
                  td
                    a(href="#").performed-workout-link
                      | Cable Crunch
                  td
                    | March.22
                  td
                    | 5:00 PM
                tr
                  td.with-load-btn(colspan="4")
                    a.load-more-content(href="#")
                      | Load more...

          .tab-content(id='completed-this-week')
            .table-container
              table
                tr
                  th
                    | Workout
                  th
                    | Date
                  th
                    | Time
                  th
                    | Status
                tr
                  td
                    a(href="#").performed-workout-link
                      | Cable Crunch
                  td
                    | Tommorow
                  td
                    | 5:00 PM
                  td
                    i.workout-status.completed
                tr
                  td
                    a(href="#").performed-workout-link
                      | Upperbody workout
                  td
                    | March.20
                  td
                    | 2:33 PM
                  td
                    i.workout-status.incomplete
                tr
                  td
                    a(href="#").performed-workout-link
                      | Strength week 1/2
                  td
                    | March.21
                  td
                    | 1:46 PM
                  td
                    i.workout-status.completed
                tr
                  td
                    a(href="#").performed-workout-link
                      | Cable Crunch
                  td
                    | March.22
                  td
                    | 5:00 PM
                  td
                    i.workout-status.completed
                tr
                  td.with-load-btn(colspan="4")
                    a.load-more-content(href="#")
                      | Load more...

    .dashboard-right-side.clearfix
      .user-best-result
        .icon
        .description
          | Congratulations on New Personal Best
        .date
          | 28 November, 2014
        .property
          span
            | Reps
          span
            | 23
        .property
          span
            | Weight (LBS)
          span
            | 100KG
        .property
          span
            | Distance
          span
            | 230M
      .weight-block
        span.title
          | Log your weight
        span.description
          | Enter your weight regularly to track progress
        form
          .form-group
            .input-group.weight-input
              input.form-control(type="text", placeholder='Weight')
              span.weight-label
                | LBS
            .input-group.gc-datetime
              input.form-control(type='text', placeholder='12/2/2014 1:03 PM')
              span.input-group-btn
                button.btn.btn-default
                  span.gc-datetime-calendar-icon
          button.btn.btn-primary.gc-custom.submit-btn
            | Submit