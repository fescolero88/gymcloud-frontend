.gc-dashboard
  header.gc-dashboard-header
    h1.title
      | Dashboard
    span.slogan
      | “I always felt that my greatest asset was
      br
      | not my physical ability, it was my mental ability.”
      br
      b
        | Bruce Jenner
  .gc-dashboard-content
    .dashboard-left-side
      .top-section.clearfix
        .workout-indicators
          .gc-workout-indicator
            svg(viewbox='0 1 10 9')
              path.stroke.default(d='M2 8 A 4 4 0 1 1 8 8')
              //- For managing progress, change first number in stroke-dasharray:
              path.stroke.progress(d='M2 8 A 4 4 0 1 1 8 8', style='stroke-dasharray: 15 20')
              .content
                span.counter
                  | 5
                span.counter-text
                  | Workouts remaining today
          .gc-workout-indicator
            svg(viewbox='0 1 10 9')
              path.stroke.default(d='M2 8 A 4 4 0 1 1 8 8')
              //- For managing progress, change first number in stroke-dasharray:
              path.stroke.progress(d='M2 8 A 4 4 0 1 1 8 8', style='stroke-dasharray: 20 20')
            .content
              span.counter
                | 23
              span.counter-text
                | Workouts completed by clients this week
        .workout-amounts
          .workout-amount
            span.counter
              | 2
            span.counter-text
              | Workouts scheduled tomorrow
          .workout-amount
            span.counter
              | 27
            span.counter-progress.positive
              | 25
            span.counter-text
              | Workouts scheduled this week vs. last week
          button.btn.btn-primary.gc-custom.calendar-button My Calendar
      .gc-dashboard-table
        region(data-name='info_tables')
    .dashboard-right-side.clearfix
      .trainer-library.clearfix
        i.icon
        .right-side
          h2.title
            | Training Library
          span.subtitle
            | Exercises, Workouts &
            br
            | Programs

      .ewp-links.clearfix
        a.exercise-link(href="#")
          | List of Exercises
        a.workout-link(href="#")
          | List of Workouts
        a.program-link(href="#")
          | List of Programs

      .gc-recent-activity.clearfix
        span.title
          | Recent Activity:
        .gc-activity-block.message
          .icon
          .text
            | Gymcloud Gymcloud sent you a new
            a(href="#")
              | message
        .gc-activity-block.comment
          .icon
          .text
            | Gymcloud Gymcloud sent you a new
            a(href="#")
              | comment
        .gc-activity-block.event
          .icon
          .text
            | Test Client1 has the
            a(href="#")
              | new event
            | scheduled
        .gc-activity-block.performed
          .icon
          .text
            a(href="#")
              | Meredith Romero
